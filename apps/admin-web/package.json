{
  "name": "mesha-admin-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node scripts/run-local-next.mjs dev",
    "dev:local": "node scripts/run-local-next.mjs dev",
    "build": "node scripts/build-with-provenance.mjs",
    "start": "node scripts/assert-origin-main-local-stack.mjs && next start",
    "start:local": "node scripts/run-local-next.mjs start",
    "auth:seed-password-users": "node scripts/seed-firebase-password-users.mjs",
    "smoke:visual:live": "node scripts/smoke-visual-live.mjs",
    "responsive:guard": "node scripts/smoke-visual-live.mjs && node scripts/check-sales-tolerance-layout.mjs",
    "smoke:action-center-drawer:live": "node scripts/smoke-action-center-local-drawer-live.mjs",
    "smoke:herd-signals-no-reload:live": "node scripts/smoke-herd-signals-no-reload-live.mjs",
    "smoke:herd-signals-mock-parity:live": "node scripts/smoke-herd-signals-mock-parity-live.mjs",
    "smoke:vaccination-click-matrix:live": "node scripts/smoke-vaccination-click-matrix-live.mjs",
    "smoke:tasks-click-matrix:live": "node scripts/smoke-tasks-click-matrix-live.mjs",
    "smoke:click-matrix:live": "node scripts/smoke-vaccination-click-matrix-live.mjs && node scripts/smoke-tasks-click-matrix-live.mjs",
    "smoke:calendar-identity:live": "GOATOS_SMOKE_ONLY_ROUTES=calendar GOATOS_SMOKE_STRICT_CALENDAR_IDENTITY=1 node scripts/smoke-visual-live.mjs",
    "smoke:sales-tolerance-layout:live": "node scripts/check-sales-tolerance-layout.mjs",
    "e2e:sop-builder": "node scripts/sop-builder-e2e.mjs",
    "smoke:visual:baseline": "node scripts/smoke-visual-live.mjs --baseline-dir .codex-goatos-render/admin-web-baselines --require-baseline",
    "smoke:visual:update-baseline": "node scripts/smoke-visual-live.mjs --baseline-dir .codex-goatos-render/admin-web-baselines --update-baseline",
    "smoke:webview": "node scripts/check-mobile-webview.mjs --baseline-dir apps/admin-web/scripts/check-mobile-webview-waivers --require-baseline",
    "smoke:webview:static": "node scripts/check-mobile-webview.mjs --static-only --baseline-dir apps/admin-web/scripts/check-mobile-webview-waivers --require-baseline",
    "smoke:webview:report": "node scripts/check-mobile-webview.mjs",
    "smoke:webview:update-baseline": "node scripts/check-mobile-webview.mjs --baseline-dir apps/admin-web/scripts/check-mobile-webview-waivers --update-baseline",
    "perf:lighthouse": "node scripts/capture-lighthouse.mjs",
    "perf:pagespeed": "node scripts/capture-pagespeed.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types \"components/**/*.test.mjs\" \"features/**/*.test.mjs\" \"lib/**/*.test.mjs\" \"scripts/**/*.test.mjs\"",
    "check:ia-guard": "node scripts/check-ia-guard.mjs",
    "check:serial-await": "node scripts/check-serial-await.mjs",
    "check:action-center-request-plan": "node --experimental-strip-types scripts/check-action-center-request-plan.mjs",
    "check:calendar-request-plan": "node scripts/check-calendar-request-plan.mjs --self-test && node scripts/check-calendar-request-plan.mjs",
    "check:request-plan-fanout": "node scripts/check-request-plan-fanout.mjs --self-test && node scripts/check-request-plan-fanout.mjs --all",
    "check:vaccination-command-lenses": "node scripts/check-vaccination-command-lenses.mjs",
    "check:herd-import-security": "node --experimental-strip-types scripts/check-herd-import-security.mjs",
    "check:goal1-frontend": "node scripts/check-goal1-frontend-coverage.mjs",
    "check:ui-contract": "node scripts/check-ui-contract-literals.mjs",
    "check:mock-fidelity": "node scripts/check-ia-guard.mjs && node scripts/check-ui-contract-literals.mjs && node scripts/check-serial-await.mjs && node --experimental-strip-types scripts/check-action-center-request-plan.mjs && npm run check:calendar-request-plan && npm run check:request-plan-fanout && npm run check:vaccination-command-lenses && node scripts/check-mock-fidelity.mjs",
    "storybook": "storybook dev -p 6007 --no-open",
    "build-storybook": "storybook build -o storybook-static",
    "smoke:stories": "node scripts/smoke-stories-visual.mjs",
    "smoke:stories:baseline": "node scripts/smoke-stories-visual.mjs --baseline-dir .codex-goatos-render/admin-web-story-baselines --require-baseline",
    "smoke:stories:update-baseline": "node scripts/smoke-stories-visual.mjs --baseline-dir .codex-goatos-render/admin-web-story-baselines --update-baseline",
    "smoke:visual:all": "npm run smoke:stories:baseline && npm run smoke:visual:baseline && npm run smoke:sales-tolerance-layout:live",
    "design:guard": "node scripts/check-design-system.mjs --self-test && node scripts/check-design-system.mjs",
    "design:guard:report": "node scripts/check-design-system.mjs --report",
    "design:guard:update-baseline": "node scripts/check-design-system.mjs --update-baseline",
    "visual:stories": "node scripts/smoke-stories-visual.mjs --require-baseline",
    "visual:stories:update-baseline": "node scripts/smoke-stories-visual.mjs --update-baseline",
    "visual:routes": "node scripts/smoke-routes-visual.mjs --require-baseline",
    "visual:audit": "node scripts/r2-visual-audit.mjs",
    "visual:gate": "bash ../../tools/ci/admin-web-visual-gate.sh",
    "visual:routes:drawers": "node scripts/smoke-routes-visual.mjs --require-baseline --open-drawers",
    "visual:routes:update-baseline": "node scripts/smoke-routes-visual.mjs --update-baseline",
    "visual:all": "npm run design:guard && npm run visual:stories && npm run visual:routes"
  },
  "dependencies": {
    "@base-ui/react": "1.5.0",
    "@emotion/cache": "11.14.0",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@fullcalendar/core": "6.1.20",
    "@fullcalendar/daygrid": "6.1.20",
    "@fullcalendar/interaction": "6.1.20",
    "@fullcalendar/list": "6.1.20",
    "@fullcalendar/react": "6.1.20",
    "@fullcalendar/timegrid": "6.1.20",
    "@goatos/api-client": "file:../../packages/api-client",
    "@grafana/faro-web-sdk": "2.8.2",
    "@grafana/faro-web-tracing": "2.8.2",
    "@iconify/react": "6.0.2",
    "@mui/material": "9.0.1",
    "@mui/material-nextjs": "9.0.1",
    "@mui/x-date-pickers": "9.1.0",
    "@tanstack/react-query": "5.101.0",
    "@tanstack/react-table": "8.21.3",
    "apexcharts": "5.11.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dayjs": "1.11.20",
    "es-toolkit": "1.46.1",
    "firebase": "^12.15.0",
    "lucide-react": "1.17.0",
    "minimal-shared": "1.1.6",
    "motion": "^13.4.0",
    "next": "16.2.9",
    "react": "19.2.7",
    "react-apexcharts": "2.1.0",
    "react-dom": "19.2.7",
    "react-markdown": "^10.1.0",
    "read-excel-file": "^9.2.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "server-only": "0.0.1",
    "simplebar-react": "3.3.2",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.3",
    "@playwright/test": "^1.61.1",
    "@storybook/addon-a11y": "^9.1.20",
    "@storybook/addon-docs": "^9.1.20",
    "@storybook/nextjs-vite": "^9.1.20",
    "@tailwindcss/postcss": "4.3.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "25.9.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.9",
    "lighthouse": "^13.4.1",
    "pixelmatch": "7.2.0",
    "pngjs": "7.0.0",
    "postcss": "8.5.15",
    "shadcn": "4.11.0",
    "storybook": "^9.1.20",
    "tailwindcss": "4.3.0",
    "typescript": "6.0.3",
    "vite": "^7.3.6"
  },
  "overrides": {
    "postcss": "8.5.15"
  }
}
