{
  "name": "mesha-admin-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "dev:local": "node scripts/run-local-next.mjs dev",
    "build": "next build && node scripts/check-token-leak.mjs",
    "start": "next start",
    "start:local": "node scripts/run-local-next.mjs start",
    "auth:seed-password-users": "node scripts/seed-firebase-password-users.mjs",
    "smoke:visual:live": "node scripts/smoke-visual-live.mjs",
    "smoke:vaccination-click-matrix:live": "node scripts/smoke-vaccination-click-matrix-live.mjs",
    "smoke:vaccination-authoring:live": "node scripts/smoke-vaccination-authoring-live.mjs",
    "smoke:calendar-identity:live": "GOATOS_SMOKE_ONLY_ROUTES=calendar GOATOS_SMOKE_STRICT_CALENDAR_IDENTITY=1 node scripts/smoke-visual-live.mjs",
    "e2e:sop-builder": "node scripts/sop-builder-e2e.mjs",
    "smoke:visual:baseline": "node scripts/smoke-visual-live.mjs --baseline-dir .codex-goatos-render/admin-web-baselines --require-baseline",
    "smoke:visual:update-baseline": "node scripts/smoke-visual-live.mjs --baseline-dir .codex-goatos-render/admin-web-baselines --update-baseline",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check:ia-guard": "node scripts/check-ia-guard.mjs",
    "check:serial-await": "node scripts/check-serial-await.mjs",
    "check:action-center-request-plan": "node --experimental-strip-types scripts/check-action-center-request-plan.mjs",
    "check:calendar-request-plan": "node scripts/check-calendar-request-plan.mjs --self-test && node scripts/check-calendar-request-plan.mjs",
    "check:request-plan-fanout": "node scripts/check-request-plan-fanout.mjs --self-test && node scripts/check-request-plan-fanout.mjs --all",
    "check:herd-import-security": "node --experimental-strip-types scripts/check-herd-import-security.mjs",
    "check:goal1-frontend": "node scripts/check-goal1-frontend-coverage.mjs",
    "check:ui-contract": "node scripts/check-ui-contract-literals.mjs",
    "check:mock-fidelity": "node scripts/check-ia-guard.mjs && node scripts/check-ui-contract-literals.mjs && node scripts/check-serial-await.mjs && node --experimental-strip-types scripts/check-action-center-request-plan.mjs && npm run check:calendar-request-plan && npm run check:request-plan-fanout && node scripts/check-mock-fidelity.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.5.0",
    "@goatos/api-client": "file:../../packages/api-client",
    "@grafana/faro-web-sdk": "2.8.2",
    "@grafana/faro-web-tracing": "2.8.2",
    "@tanstack/react-query": "5.101.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "firebase": "^12.15.0",
    "lucide-react": "1.17.0",
    "next": "16.2.9",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "read-excel-file": "^9.2.0",
    "recharts": "3.8.1",
    "server-only": "0.0.1",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.3",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "4.3.0",
    "@types/node": "25.9.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.9",
    "pixelmatch": "7.2.0",
    "pngjs": "7.0.0",
    "postcss": "8.5.15",
    "shadcn": "4.11.0",
    "tailwindcss": "4.3.0",
    "typescript": "6.0.3"
  },
  "overrides": {
    "postcss": "8.5.15"
  }
}
