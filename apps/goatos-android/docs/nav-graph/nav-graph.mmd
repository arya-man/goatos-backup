flowchart TD
    r_calendar(["Calendar<br/><code>/calendar</code>"]):::start
    r_vaccination["Sheds (vaccination execution)<br/><code>/vaccination</code>"]
    r_scan["Scan<br/><code>/scan?shedId={shedId}</code>"]
    r_submit["Submit<br/><code>/submit</code>"]
    r_leadership["Overview (leadership)<br/><code>/leadership</code>"]
    r_record["Record (read-only)<br/><code>/record?shedId={shedId}</code>"]
    r_overdue["Overdue<br/><code>/overdue</code>"]
    r_reschedule["Reschedule<br/><code>/reschedule</code>"]
    r_you["You / Settings<br/><code>you</code>"]
    r_rfid["RFID reader<br/><code>/rfid</code>"]
    r_alerts["Alerts<br/><code>/alerts</code>"]
    back((Back / pop)):::back
    r_calendar -->|"tap history/week item → history target is a past record"| r_record
    r_calendar -->|"tap week item (no record target) or tap a day"| r_vaccination
    r_vaccination -->|"tap a DONE shed → read-only record"| r_record
    r_vaccination -->|"tap an open shed → execute (Scan → Submit)"| r_scan
    r_scan -->|"Submit"| r_submit
    r_scan -->|"Back"| back
    r_leadership -->|"Decision tapped"| r_reschedule
    r_leadership -->|"Shed tapped (leadership = read-only follow-up)"| r_record
    r_leadership -->|"KPI tapped (not 'given')"| r_overdue
    r_overdue -->|"Row tapped"| r_reschedule
    r_overdue -->|"Back"| back
    r_reschedule -->|"Confirm or Back"| back
    r_record -->|"Close"| back
    r_you -->|"Pair RFID"| r_rfid
    r_you -->|"Toggle notifications"| r_alerts
    sheet_leadership_scopepickersheet(["ScopePickerSheet (overlay)"]):::sheet
    r_leadership -.-> sheet_leadership_scopepickersheet
    sheet_leadership_datagapssheet(["DataGapsSheet (overlay)"]):::sheet
    r_leadership -.-> sheet_leadership_datagapssheet
    sheet_leadership_dosesgivensheet(["DosesGivenSheet (overlay)"]):::sheet
    r_leadership -.-> sheet_leadership_dosesgivensheet
    sheet_you_languagesheet(["LanguageSheet (overlay)"]):::sheet
    r_you -.-> sheet_you_languagesheet
    classDef start fill:#8ad457,stroke:#5f9c37,color:#0a0f0c,font-weight:bold;
    classDef back fill:#232b26,stroke:#3a453e,color:#c9d6cf,stroke-dasharray: 3 3;
    classDef sheet fill:#182019,stroke:#3a453e,color:#9db3a7,stroke-dasharray: 2 2;
