    <!-- FCM push notifications (GoatOsMessagingService, PushNotifications). Two channels: a
         high-importance one for vaccination obligation/escalation alerts, a default-importance
         one for everything else. push_channel_general_id is the LITERAL channel id string (not
         translatable, no locale variants needed) — it is read at runtime to both create the
         channel AND set AndroidManifest's com.google.firebase.messaging.default_notification_channel_id
         meta-data, so the two always agree. -->
    <string name="push_channel_general_id" translatable="false">goatos-push-general</string>
    <string name="push_channel_vaccination_id" translatable="false">goatos-push-vaccination</string>
