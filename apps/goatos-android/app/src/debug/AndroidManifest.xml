<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Debug-only screenshot harness. It is exported for adb-driven pixel captures, but it is
             declared only in the debug source set so release APKs never ship the activity. -->
        <activity
            android:name=".GalleryActivity"
            android:exported="true"
            android:theme="@style/Theme.GoatOs" />

        <activity
            android:name=".ShowkaseLauncherActivity"
            android:exported="true"
            android:label="Mesha UI Gallery"
            android:theme="@style/Theme.GoatOs" />

        <activity
            android:name=".ProofMediaSampleActivity"
            android:exported="true"
            android:label="Proof Media Sample"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.GoatOs" />

        <!-- Debug-only harness for the capture -> trim -> join flow. Drives the REAL capture
             composables with the editing flag forced on locally, so the editor's device
             behaviour can be verified without standing up the whole phone-QA stack. Declared
             only in the debug source set, so release APKs never ship it. -->
        <activity
            android:name=".ProofTrimFlowSampleActivity"
            android:exported="true"
            android:label="Proof Trim Flow"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.GoatOs" />

        <!-- Debug-only deterministic BT-HID/RFID E2E seam. Physical-device tests broadcast a
             tag while the real scan route is active; the receiver feeds the SAME singleton
             RfidReaderPort/key-event buffer as a hardware keyboard wedge. Release variants do
             not merge this receiver, so production has no remotely injectable scan surface. -->
        <receiver
            android:name="sg.mesha.goatos.rfid.DebugRfidInjectionReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="sg.mesha.goatos.debug.INJECT_RFID" />
            </intent-filter>
        </receiver>

        <receiver
            android:name="sg.mesha.goatos.debug.DebugNavigationReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="sg.mesha.goatos.debug.NAVIGATE" />
            </intent-filter>
        </receiver>

        <!-- Debug-only startup hook that forwards LeakCanary heap-analysis leaks to Crashlytics
             (see sg.mesha.goatos.leak.LeakCanaryBridgeInstaller). No-op ContentProvider used purely
             for its onCreate() at process start; not exported, unique authority per applicationId. -->
        <provider
            android:name="sg.mesha.goatos.leak.LeakCanaryBridgeInstaller"
            android:authorities="${applicationId}.leakcanary-bridge-installer"
            android:exported="false"
            android:initOrder="1" />
    </application>
</manifest>
