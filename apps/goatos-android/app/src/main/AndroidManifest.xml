<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- CameraX proof capture (docs/mobile/trd-operator-mobile.md §2/§7; MOB-002 "Camera-only
         capture" anti-fraud rule — docs/mobile/proof-capture-sync-and-e2e.md). Live in-app
         video recording is the ONLY way to produce a `video_proof` capture: mandatory for the
         capture/submit surface (operator/park-manager role), gated at that surface's entry
         (docs/mobile/proof-capture-sync-and-e2e.md §4). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <!-- Obligation/escalation alert notifications rendered from FCM
         (docs/mobile/trd-operator-mobile.md §8), AND the MOB-002 background upload progress
         notification (docs/mobile/proof-capture-sync-and-e2e.md §3, UploadForegroundService).
         Runtime-requestable only on Android 13+ (TIRAMISU); declaring it on older OS versions is
         a documented no-op. Already mandatory-gated at the capture surface entry
         (CaptureAccessGate.kt). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- MOB-002 background upload foreground service (docs/mobile/proof-capture-sync-and-e2e.md
         §3 "Background sync survives app close" — UploadForegroundService). FOREGROUND_SERVICE is
         a normal permission required for any foreground service; FOREGROUND_SERVICE_DATA_SYNC is
         the typed permission Android 14+ requires for a `dataSync`-typed foreground service
         (harmless no-op declaration on older OS versions, same pattern as POST_NOTIFICATIONS
         above). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- RFID keyboard-wedge reader (docs/mobile/rfid-keyboard-reader.md). Android owns the
         HID connection; these gate paired-device readiness + optional discovery. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />

    <!-- Storage for captured proof videos (MOB-002, docs/mobile/proof-capture-sync-and-e2e.md
         §4 mandatory-permission gate). Videos are written to this app's OWN PRIVATE storage
         (`Context.filesDir` — never external/MediaStore/gallery, part of the "Camera-only
         capture" anti-fraud rule) — WRITE_EXTERNAL_STORAGE is declared only up to API 32 for
         the mandatory-permission gate's own completeness on legacy devices; API 33+ needs no
         storage permission at all for an app-private directory. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <application
        android:name=".GoatOsApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="Mesha"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.GoatOs">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.GoatOs">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- MOB-002 background upload foreground service (docs/mobile/proof-capture-sync-and-e2e.md
             §3). `dataSync` type: it drains outbox writes (proof-video registrations + shed
             submissions), not media playback/location/camera/etc. Never exported — only this app
             (via ForegroundSyncController.ensureRunning -> AndroidForegroundSyncController) starts
             it. -->
        <service
            android:name=".sync.UploadForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <!-- Disable WorkManager's default on-startup initializer: GoatOsApplication implements
             Configuration.Provider to supply a Hilt HiltWorkerFactory (on-demand init), so the
             default initializer must NOT run first with a factory that can't build @HiltWorker. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>
</manifest>
