<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- CameraX proof capture (docs/mobile/trd-operator-mobile.md §2/§7; MOB-002 "Camera-only
         capture" anti-fraud rule — docs/mobile/proof-capture-sync-and-e2e.md). Live in-app
         video recording is the ONLY way to produce a `video_proof` capture: mandatory for the
         ground-operator capture/submit surface, gated at that surface's entry
         (docs/mobile/proof-capture-sync-and-e2e.md §4). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <!-- Obligation/escalation alert notifications rendered from FCM
         (docs/mobile/trd-operator-mobile.md §8), AND the MOB-002 background upload progress
         notification (docs/mobile/proof-capture-sync-and-e2e.md §3, UploadForegroundService).
         Runtime-requestable only on Android 13+ (TIRAMISU); declaring it on older OS versions is
         a documented no-op. Already mandatory-gated at the capture surface entry
         (CaptureAccessGate.kt). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- MOB-002 background upload foreground service (docs/mobile/proof-capture-sync-and-e2e.md
         §3 "Background sync survives app close" — UploadForegroundService). FOREGROUND_SERVICE is
         a normal permission required for any foreground service; FOREGROUND_SERVICE_DATA_SYNC is
         the typed permission Android 14+ requires for a `dataSync`-typed foreground service
         (harmless no-op declaration on older OS versions, same pattern as POST_NOTIFICATIONS
         above). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- RFID keyboard-wedge reader (docs/mobile/rfid-keyboard-reader.md). Android owns the
         HID connection; these gate paired-device readiness + optional discovery. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />

    <!-- Camera proof clips are written to app-private `Context.filesDir`; no storage
         permission or gallery/file-picker access is declared. -->

    <application
        android:name=".GoatOsApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="${appLabel}"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.GoatOs">
        <!-- Firebase Performance Monitoring auto-init calls FirebaseInstallations.getId(), which
             HARD-THROWS (IllegalArgumentException "valid API key required") when the Firebase API
             key isn't real. dev/prod ship a structurally-valid PLACEHOLDER google-services.json (a
             real one is injected at build for stg/prod), so firebase-perf crashes the whole process
             on launch — unlike Analytics/Crashlytics/Messaging, which degrade gracefully. Disable
             perf auto-collection so the app survives launch on every flavor regardless of whether a
             real Firebase config is present. Proven on-device (Infinix X6873): app launches clean +
             FCM token registers after this. -->
        <meta-data android:name="firebase_performance_collection_enabled" android:value="false" />
        <meta-data android:name="firebase_performance_collection_deactivated" android:value="true" />
        <!-- android:configChanges — the V1 RFID reader is a Bluetooth HID KEYBOARD (logcat:
             EventHub "New device ... name='IDT RHLS-3', classes=KEYBOARD | ALPHAKEY | CURSOR |
             EXTERNAL"). Every reader connect AND every disconnect therefore changes
             Configuration.keyboard / hardKeyboardHidden / navigation. Without declaring those
             configs here the platform DESTROYS AND RELAUNCHES this Activity on each edge —
             proven on a POCO X5 Pro 5G: reader drop at 01:46:19.930 → "finishDrawing of
             relaunch" + "Screen frozen for +283ms" at 01:46:20.2, then "Bootstrap loaded" from
             scratch. The relaunch tears down the Activity-scoped BootstrapViewModel, so the shell
             recomposes on a fresh NavHost at the operator's landing route (/vaccination = the
             sheds list) and the operator is thrown out of the scan screen mid-drive — on every
             reader reconnect.

             Handling these in-process is the fix, not a workaround: nothing in this app renders
             off the keyboard/navigation config, orientation is locked portrait, and the reader
             already observes connect/disconnect itself (KeyboardWedgeRfidReader, via
             InputManager.InputDeviceListener + BluetoothDevice.ACTION_ACL_*), so the RFID banner
             still flips without an Activity relaunch. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="keyboard|keyboardHidden|navigation"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.GoatOs">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- MOB-002 background upload foreground service (docs/mobile/proof-capture-sync-and-e2e.md
             §3). `dataSync` type: it drains outbox writes (proof-video registrations + shed
             submissions), not media playback/location/camera/etc. Never exported — only this app
             (via ForegroundSyncController.ensureRunning -> AndroidForegroundSyncController) starts
             it. -->
        <service
            android:name=".sync.UploadForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <!-- FCM push entry point (docs: FCM push slice). Never exported — only the system's
             own FCM broadcast reaches it, gated by the MESSAGING_EVENT intent-filter. -->
        <service
            android:name=".push.GoatOsMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <!-- Default channel FCM uses when a message doesn't specify android_channel_id
             (PushNotifications.CHANNEL_GENERAL — the string value + this meta-data both read the
             SAME @string/push_channel_general_id so they can never drift). Icon/color are the
             defaults for a system-auto-displayed notification (app backgrounded/killed); this
             app's OWN NotificationCompat.Builder path (PushNotifications.show, used while the app
             is foregrounded) sets the identical icon/color explicitly rather than relying on
             these being read implicitly. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="@string/push_channel_general_id" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification_push" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/push_notification_accent" />
        <!-- Disable WorkManager's default on-startup initializer: GoatOsApplication implements
             Configuration.Provider to supply a Hilt HiltWorkerFactory (on-demand init), so the
             default initializer must NOT run first with a factory that can't build @HiltWorker. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>
</manifest>
