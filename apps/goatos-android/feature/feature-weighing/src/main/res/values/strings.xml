<?xml version="1.0" encoding="utf-8"?>
<!--
  Weighing module (v-weighing) chrome strings. Operators see the execution surface,
  leadership sees the planner, task board, shed detail and video gallery. Every status
  word that the backend owns still arrives from the backend; these strings cover only
  the static chrome this app renders itself: headers, section labels, button labels,
  empty/loading/error states, confirm-sheet copy and disabled-with-reason text.
-->
<!-- telemetry:exempt string resources carry no behaviour to instrument. The weighing
     screens that render them wire AnalyticsPort in their ViewModels, which is where a
     user action can actually be observed. -->
