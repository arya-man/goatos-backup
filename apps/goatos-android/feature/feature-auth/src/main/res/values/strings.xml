<?xml version="1.0" encoding="utf-8"?>
<!--
  Login (v-login) chrome strings. Translations are ported verbatim from the mock's TXT
  dictionary in mock/vaccination-mobile-mock.html (keys noted per string) so the app and
  the mock never drift. Two strings intentionally have NO locale variants: the brand mark
  "मे" (fixed Devanagari mark, not a translation) and "Mesha" (brand name).
-->
<resources>
    <string name="login_brand_name">Mesha</string>
    <string name="login_tagline">Field operations</string> <!-- mock: tagline -->
    <string name="login_field_work_email">Work email</string> <!-- mock: email -->
    <string name="login_email_hint">you@mesha.sg</string>
    <string name="login_field_password">Password</string>
    <string name="login_password_hint">Your password</string>
    <string name="login_sign_in">Sign in</string> <!-- mock: signin -->
    <string name="login_use_email_password">Use your Mesha work email and password.</string> <!-- mock: otpnote -->
    <string name="login_app_language">App language</string> <!-- mock: applang -->
    <string name="login_change">Change</string> <!-- mock: change -->
    <string name="login_role_note">Your role comes from the HR directory — you land on the screen for your job. The field operator executes; managers and directors track.</string> <!-- mock: rbac -->

    <string name="login_continue_with_google">Continue with Google</string>
    <string name="login_or_divider">or</string>
    <string name="login_forgot_password">Forgot password?</string>
    <string name="login_signing_in">Signing in…</string>
    <string name="login_reset_sent">Reset link sent to %1$s</string>
    <string name="login_show_password">Show password</string>
    <string name="login_hide_password">Hide password</string>
    <string name="login_error_invalid_credentials">Email or password is incorrect.</string>
    <string name="login_error_network">Network error. Check your connection and try again.</string>
    <string name="login_error_too_many_requests">Too many attempts. Try again later.</string>
    <string name="login_error_google_cancelled">Google sign-in was cancelled.</string>
    <string name="login_error_no_google_account">No Google account found on this device.</string>
    <string name="login_error_no_dev_backend">This build has no backend session configured. Install a dev build with goatosDevBearerToken set, or a Firebase-verified build, to sign in.</string>
    <string name="login_error_generic">Sign-in failed. Try again.</string>

    <!-- Optional device-readiness copy retained for operator onboarding surfaces. -->
    <string name="perm_gate_title">Device permissions</string>
    <string name="perm_gate_subtitle">Grant these once so scanning, alerts, and camera proof work in the field.</string>
    <string name="perm_gate_footer">You can still sign in without these. Operator capture will ask when access is needed.</string>
    <string name="perm_gate_grant_access">Grant access</string>
    <string name="perm_label_camera">Camera</string>
    <string name="perm_rationale_camera">Records camera-only proof clips for each scanned goat.</string>
    <string name="perm_label_bluetooth">Nearby devices</string>
    <string name="perm_rationale_bluetooth">Reads the paired RFID reader\'s connection status.</string>
    <string name="perm_label_notifications">Notifications</string>
    <string name="perm_rationale_notifications">Delivers vaccination due/overdue alerts.</string>
    <string name="perm_status_granted">Granted</string>
    <string name="perm_status_needed">Needed</string>
    <string name="perm_status_open_settings">Open Settings</string>

    <!-- Mandatory role-based permission gate (RoleBasedPermissionGate.kt).
         Non-dismissible dialog shown after bootstrap. Operators require camera, BLE, and notifications.
         All roles require notifications. Farm language: explain consequences and navigate to settings if needed. -->
    <string name="mandatory_permissions_title">Grant permissions to continue</string>
    <string name="mandatory_permissions_body">This phone needs these permissions before you can start work. The app will not work without them.</string>
    <string name="mandatory_permissions_why">Camera records proof videos for each animal. Notifications tell you when work is due. Nearby devices connects your RFID reader.</string>
    <string name="mandatory_permissions_grant">Grant permissions</string>
    <string name="mandatory_permissions_settings">Open settings</string>
    <string name="mandatory_permissions_settings_help">Your phone will not ask again. Open the settings app below. Find Mesha, tap Permissions, and enable the required permissions. Return to this app when done.</string>
    <string name="mandatory_permissions_retry_help">Your phone can still ask. Tap the button above and choose Allow — work cannot start until every permission below is on.</string>
    <string name="perm_label_location">Location</string>
    <string name="perm_rationale_location">Shows which park and shed the work was done in.</string>
</resources>
