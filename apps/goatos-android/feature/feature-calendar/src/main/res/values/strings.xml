<?xml version="1.0" encoding="utf-8"?>
<!--
  telemetry:exempt Resource strings; telemetry wired in feature module screens
-->
<!--
  Calendar (v-calendar) chrome strings. Segment labels, empty states, hints, and
  accessibility descriptions for the Calendar screen (universal landing for all roles).
  Most labels (title, eyebrow, segment labels, counts, status/category pills) come from
  the backend; these strings are fallback/preview constants and UI affordances.
-->
<resources>
    <!-- Screen chrome -->
    <string name="calendar_eyebrow">Vaccination</string>
    <string name="calendar_title">Calendar</string>

    <!-- Segment labels (week/month/history tabs) -->
    <string name="calendar_segment_week">Week</string>
    <string name="calendar_segment_month">Month</string>
    <string name="calendar_segment_history">History</string>

    <!-- Empty states -->
    <string name="calendar_week_empty">No drives scheduled</string>
    <string name="calendar_history_empty">No accepted completion history</string>
    <string name="calendar_day_sheet_empty">No drives scheduled this day</string>
    <string name="calendar_month_empty">No vaccination drives match these filters</string>

    <!-- Month grid hint -->
    <string name="calendar_month_hint">Tap a day for due work or completion history · dots = open work, muted dots = completed history</string>

    <!-- Accessibility descriptions -->
    <string name="calendar_day_back">Back</string>
    <string name="calendar_button_refresh">Refresh</string>

    <!-- History section label (prefix before dynamic count) -->
    <string name="calendar_history_label">Accepted completion history</string>

    <!-- Card call-to-action verb (drill into a drive) -->
    <string name="calendar_cta_open">Open</string>

    <!-- Pagination -->
    <string name="calendar_load_more_day">Load more drives</string>
    <string name="calendar_load_more_history">Load more history</string>
    <string name="calendar_all_day">All day</string>
    <string name="calendar_drive_sheds">Sheds</string>
