# graphify: commit ONLY the generation skills/scripts (tools/agent-hooks/*.sh),
# NEVER the generated graphs themselves (user rule 2026-06-25). Graphs are
# machine-regenerated locally by the docs-graph hook; they do not belong in git.
graphify-out/graph.json
graphify-out/manifest.json
graphify-out/GRAPH_REPORT.md
graphify-out/graph.html
graphify-out/cost.json
graphify-out/.graphify_python
graphify-out/cache/

# repowise: same policy — commit ONLY the setup script (tools/agent-hooks/
# repowise-setup.sh). The index/caches and repowise's per-clone project
# registration are machine-regenerated by `make ai-setup`; never commit them.
.repowise/
/.mcp.json
/.vscode/

# generated telemetry report (make ai-telemetry-ui) — local-only, has no secrets
# but is machine-specific; never commit
/ai-telemetry.html

# generated E2E harness report (rendered by backend/tests/e2e/report.go via
# TestMain; .github/workflows/pages.yml regenerates it in CI before publishing)
backend/tests/e2e/report/*
# hand-authored audit reports inside the category are committed, not generated
!backend/tests/e2e/report/vaccination-closure-audit-2026-07-19.html

wiki/

# Claude subagent worktrees (isolation:worktree) — local scratch, never commit
.claude/worktrees/
.claude/settings.local.json

# compiled cmd binaries accidentally produced by `go build ./cmd/<x>` (no /...)
