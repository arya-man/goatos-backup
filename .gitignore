/backend/cmd/seed-shed-positions/shed_manager_mapping.csv

# Python bytecode
__pycache__/
*.pyc

# compiled backend binary (never commit)
/backend/api

# make e2e-smoke's saved compose logs (regenerated every run, local diagnostics only)
