+	if config.shedCalls != shedCallsBefore || config.snapshotCalls != snapCallsBefore || counts.calls != countCallsBefore {
+		t.Fatalf("serving an issued sheet issued generation reads (shed %d->%d, snap %d->%d, counts %d->%d)",
