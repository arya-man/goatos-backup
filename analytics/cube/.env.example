# Mesha Cube — local config template (NAMES ONLY, no secret values).
# Copy relevant lines into the gitignored repo-root .env.ceo-ai.local, or export
# them in your shell. Values for stg come from Secret Manager (project goatos-stg).
# See docs/runbooks/cube-local.md.

MESHA_CUBE_URL=http://127.0.0.1:4000
MESHA_CUBE_API_SECRET=
MESHA_CUBE_DB_HOST=host.docker.internal
MESHA_CUBE_DB_PORT=5433
MESHA_CUBE_DB_NAME=goatos
MESHA_CUBE_DB_USER=postgres
MESHA_CUBE_DB_PASSWORD=
