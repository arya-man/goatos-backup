  "panels": [
    {
      "id": 1,
      "title": "What this shows",
      "type": "text",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "options": {
        "mode": "markdown",
        "content": "Top row queries Cloud Run native metrics; current non-empty data must be proven by the live Grafana smoke for the deployed environment. Feature rows use app route metrics (`http_server_requests_total` and `http_server_request_duration_seconds`) from Google Managed Prometheus under `resource.type=\"prometheus_target\"`, grouped by backend route template, so Weighing, Vaccination, Feed, Sales, Procurement and other feature traffic show separately when those routes receive requests in the selected time window."
      }
    },
