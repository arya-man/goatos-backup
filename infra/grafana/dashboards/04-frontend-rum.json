{
  "uid": "goatos-stg-frontend-rum",
  "title": "Goat OS \u2014 Frontend RUM (admin-web)",
  "description": "Real browser Faro measurements exported to Cloud Logging and log-based Cloud Monitoring metrics. Receiver HTTP traffic alone is only connectivity evidence. Empty telemetry is not synthesized into zero or healthy sessions.",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "timezone": "Asia/Kolkata",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "1m",
  "tags": [
    "goatos",
    "rum",
    "admin-web",
    "faro"
  ],
  "panels": [
    {
      "id": 100,
      "title": "Browser collection and receiver health",
      "type": "row",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 1,
      "title": "Grafana Alloy (faro.receiver) request rate by status class",
      "description": "Alloy receiver HTTP traffic, including connectivity probes. A healthy receiver does not prove browser telemetry; the browser measurement/event panels below must contain real traffic.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "datasource": "Google Cloud Monitoring",
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 15,
            "lineWidth": 1,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": "Google Cloud Monitoring",
          "aliasBy": "{{metric.label.response_code_class}}",
          "queryType": "timeSeriesList",
          "timeSeriesList": {
            "projectName": "goatos-stg",
            "view": "FULL",
            "groupBys": [
              "metric.label.response_code_class"
            ],
            "perSeriesAligner": "ALIGN_RATE",
            "crossSeriesReducer": "REDUCE_SUM",
            "alignmentPeriod": "300s",
            "filters": ["resource.type", "=", "cloud_run_revision", "AND", "metric.type", "=", "run.googleapis.com/request_count", "AND", "resource.label.service_name", "=", "goatos-stg-grafana-alloy"]
          }
        }
      ]
    },
    {
      "id": 2,
      "title": "Grafana Alloy request latency p50 / p99",
      "description": "run.googleapis.com/request_latencies (a DELTA/DISTRIBUTION metric) on goatos-stg-grafana-alloy. GCP Cloud Monitoring's percentile aligner supports only p50/p95/p99 (ALIGN_PERCENTILE_90 is rejected by the API, verified live) \u2014 p99 shown here, p95 would stand in for p90 if needed.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "datasource": "Google Cloud Monitoring",
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": "Google Cloud Monitoring",
          "aliasBy": "p50",
          "queryType": "timeSeriesList",
          "timeSeriesList": {
            "projectName": "goatos-stg",
            "view": "FULL",
            "perSeriesAligner": "ALIGN_PERCENTILE_50",
            "crossSeriesReducer": "REDUCE_NONE",
            "alignmentPeriod": "300s",
            "filters": ["resource.type", "=", "cloud_run_revision", "AND", "metric.type", "=", "run.googleapis.com/request_latencies", "AND", "resource.label.service_name", "=", "goatos-stg-grafana-alloy"]
          }
        },
        {
          "refId": "B",
          "datasource": "Google Cloud Monitoring",
          "aliasBy": "p99",
          "queryType": "timeSeriesList",
          "timeSeriesList": {
            "projectName": "goatos-stg",
            "view": "FULL",
            "perSeriesAligner": "ALIGN_PERCENTILE_99",
            "crossSeriesReducer": "REDUCE_NONE",
            "alignmentPeriod": "300s",
            "filters": ["resource.type", "=", "cloud_run_revision", "AND", "metric.type", "=", "run.googleapis.com/request_latencies", "AND", "resource.label.service_name", "=", "goatos-stg-grafana-alloy"]
          }
        }
      ]
    },
    {
      "id": 101,
      "title": "Observed browser measurements and events",
      "type": "row",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 3,
      "title": "Browser Web Vitals p95 \u2014 LCP / INP / TTFB",
      "type": "timeseries",
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 0,
        "y": 10
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "datasource": "Google Cloud Monitoring",
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": "Google Cloud Monitoring",
          "queryType": "timeSeriesList",
          "timeSeriesList": {
            "projectName": "goatos-stg",
            "view": "FULL",
            "filters": ["metric.type", "=", "logging.googleapis.com/user/goatos_rum_lcp_ms"],
            "groupBys": [],
            "perSeriesAligner": "ALIGN_PERCENTILE_95",
            "crossSeriesReducer": "REDUCE_NONE",
            "alignmentPeriod": "300s"
          },
          "aliasBy": "LCP"
        },
        {
          "refId": "B",
          "datasource": "Google Cloud Monitoring",
          "queryType": "timeSeriesList",
          "timeSeriesList": {
            "projectName": "goatos-stg",
            "view": "FULL",
            "filters": ["metric.type", "=", "logging.googleapis.com/user/goatos_rum_inp_ms"],
            "groupBys": [],
            "perSeriesAligner": "ALIGN_PERCENTILE_95",
            "crossSeriesReducer": "REDUCE_NONE",
            "alignmentPeriod": "300s"
          },
          "aliasBy": "INP"
        },
        {
          "refId": "C",
          "datasource": "Google Cloud Monitoring",
          "queryType": "timeSeriesList",
          "timeSeriesList": {
            "projectName": "goatos-stg",
            "view": "FULL",
            "filters": ["metric.type", "=", "logging.googleapis.com/user/goatos_rum_ttfb_ms"],
            "groupBys": [],
            "perSeriesAligner": "ALIGN_PERCENTILE_95",
            "crossSeriesReducer": "REDUCE_NONE",
            "alignmentPeriod": "300s"
          },
          "aliasBy": "TTFB"
        }
      ],
      "description": "p95 of observed browser web-vital samples in each five-minute interval. INP requires a qualifying user interaction; no INP sample is not a zero. Log distributions represent actual Faro measurements, not receiver request latency."
    },
    {
      "id": 4,
      "title": "Browser cumulative layout shift p95",
      "type": "timeseries",
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 12,
        "y": 10
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "datasource": "Google Cloud Monitoring",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": "Google Cloud Monitoring",
          "queryType": "timeSeriesList",
          "timeSeriesList": {
            "projectName": "goatos-stg",
            "view": "FULL",
            "filters": ["metric.type", "=", "logging.googleapis.com/user/goatos_rum_cls"],
            "groupBys": [],
            "perSeriesAligner": "ALIGN_PERCENTILE_95",
            "crossSeriesReducer": "REDUCE_NONE",
            "alignmentPeriod": "300s"
          }
        }
      ],
      "description": "Unitless CLS from actual Faro web-vitals measurements. Missing browser samples remain missing."
    },
    {
      "id": 5,
      "title": "Browser JavaScript exceptions",
      "type": "timeseries",
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "datasource": "Google Cloud Monitoring",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": "Google Cloud Monitoring",
          "queryType": "promQL",
          "timeSeriesList": {},
          "promQLQuery": {
            "projectName": "goatos-stg",
            "expr": "sum(increase(logging_googleapis_com:user_goatos_rum_exceptions[5m]))",
            "step": "300s"
          },
          "goatosDataCondition": {
            "kind": "event-conditional",
            "event": "Browser reported a JavaScript exception",
            "source": "infra/observability/alloy-config.alloy"
          }
        }
      ],
      "description": "Observed exception log entries per five-minute interval, not a session error percentage. No samples can mean no reported exceptions; collection coverage is verified separately."
    },
    {
      "id": 6,
      "title": "Browser session-start events",
      "type": "timeseries",
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "datasource": "Google Cloud Monitoring",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": "Google Cloud Monitoring",
          "queryType": "promQL",
          "timeSeriesList": {},
          "promQLQuery": {
            "projectName": "goatos-stg",
            "expr": "sum(increase(logging_googleapis_com:user_goatos_rum_session_starts[5m]))",
            "step": "300s"
          }
        }
      ],
      "description": "Reported session-start events per five-minute interval. This is not a distinct-session cardinality calculation; retries or client lifecycle behavior can affect event counts."
    },
    {
      "id": 7,
      "title": "SPA route-view events",
      "type": "timeseries",
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 0,
        "y": 22
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "datasource": "Google Cloud Monitoring",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": "Google Cloud Monitoring",
          "queryType": "promQL",
          "timeSeriesList": {},
          "promQLQuery": {
            "projectName": "goatos-stg",
            "expr": "sum(increase(logging_googleapis_com:user_goatos_rum_route_views[5m]))",
            "step": "300s"
          }
        }
      ],
      "description": "Actual admin_route_view browser events, including client-side navigation. Counts are observations rather than distinct users."
    },
    {
      "id": 8,
      "title": "Session-start events by browser",
      "type": "timeseries",
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 12,
        "y": 22
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "datasource": "Google Cloud Monitoring",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": "Google Cloud Monitoring",
          "queryType": "promQL",
          "timeSeriesList": {},
          "aliasBy": "{{browser}}",
          "promQLQuery": {
            "projectName": "goatos-stg",
            "expr": "sum by (browser)(increase(logging_googleapis_com:user_goatos_rum_session_starts[5m]))",
            "step": "300s"
