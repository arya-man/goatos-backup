    {
      "id": 7,
      "title": "Notification dispatch success rate (SLO > 99%)",
      "description": "100 * (1 - rate(kernel.notify.failures) / rate(kernel.notify.send.duration count)). notification_success_slo_ratio = 99%; failure alert threshold 1%.",
