{
  "uid": "goatos-stg-slo-burn",
  "title": "Goat OS \u2014 SLO / burn rate",
  "description": "Availability + latency SLOs with multi-window burn-rate framing per OBSERVABILITY_DESIGN.md section 7. Every threshold below is read directly from infra/envs/stg/variables.tf so this dashboard cannot drift from the alert policies in infra/envs/stg/monitoring.tf: api_availability_slo=99.5%, api_error_rate_alert_threshold_ratio=1%, api_latency_p99_read_slo_seconds=0.8s, api_latency_p99_write_slo_seconds=1.5s, consumer_lag_slo_seconds=60s, notification_success_slo_ratio=99% (failure alert threshold 1%). Queried through the 'Google Cloud Monitoring' (stackdriver) datasource \u2014 this environment has no Prometheus datasource; ratio panels use Cloud Monitoring's native MQL join (verified live) instead of PromQL.",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "timezone": "Asia/Kolkata",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "refresh": "1m",
  "tags": [
    "goatos",
    "slo",
    "burn-rate"
  ],
  "panels": [
    {
      "id": 100,
      "title": "Error budget",
      "type": "row",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 1,
      "title": "API availability \u2014 selected window (SLO 99.5%)",
      "description": "Ratio of counter increases across the entire selected time window, weighted by request count; evaluated at the selected end. Counter resets handled before sum. No requests yields no availability. Historical hourly percentages are not averaged or reduced to the latest hour.",
      "type": "stat",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "datasource": "Google Cloud Monitoring",
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 99,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 99.3
              },
              {
                "color": "green",
                "value": 99.5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "graphMode": "area",
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "uid": "cloud-monitoring",
            "type": "stackdriver"
          },
          "queryType": "promQL",
          "timeSeriesList": {},
          "promQLQuery": {
            "projectName": "goatos-stg",
            "expr": "100 * (1 - (sum(increase(http_server_requests_total{status_class=\"5xx\"}[${window_seconds}s] @ end())) or (0 * sum(increase(http_server_requests_total[${window_seconds}s] @ end())))) / sum(increase(http_server_requests_total[${window_seconds}s] @ end())))",
            "step": "300s"
          }
        }
      ]
    },
    {
      "id": 2,
      "title": "Error budget remaining \u2014 selected window",
      "description": "Ratio of counter increases across the entire selected time window, weighted by request count; evaluated at the selected end. Counter resets handled before sum. No requests yields no availability. Historical hourly percentages are not averaged or reduced to the latest hour.",
      "type": "gauge",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "datasource": "Google Cloud Monitoring",
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 30
              },
              {
                "color": "green",
                "value": 60
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "uid": "cloud-monitoring",
            "type": "stackdriver"
          },
          "queryType": "promQL",
          "timeSeriesList": {},
          "promQLQuery": {
            "projectName": "goatos-stg",
            "expr": "100 * (1 - ((sum(increase(http_server_requests_total{status_class=\"5xx\"}[${window_seconds}s] @ end())) or (0 * sum(increase(http_server_requests_total[${window_seconds}s] @ end())))) / sum(increase(http_server_requests_total[${window_seconds}s] @ end()))) / 0.005)",
            "step": "300s"
          }
        }
      ]
    },
    {
      "id": 3,
      "title": "Error budget burn rate (1h / 6h windows)",
      "description": "Burn rate = observed error rate / (1 - SLO). A burn rate of 1.0 exhausts the full 30d error budget in exactly 30d. Threshold lines at 14.4x (fast/1h page, matches Google SRE multi-window guidance) and 6x (slow/6h page) \u2014 infra/envs/stg/monitoring.tf's api_error_rate_slo_burn policy currently pages on the simpler 'error rate over 5m exceeds 1%' condition rather than these exact multipliers; the lines below show where a genuine multi-window burn-rate alert would sit if adopted.",
      "type": "timeseries",
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "datasource": "Google Cloud Monitoring",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 6
              },
              {
                "color": "red",
                "value": 14.4
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": "Google Cloud Monitoring",
          "aliasBy": "1h burn rate",
          "queryType": "timeSeriesQuery",
          "timeSeriesQuery": {
            "projectName": "goatos-stg",
            "query": "{ err: fetch prometheus_target :: 'prometheus.googleapis.com/http_server_requests_total/counter' | filter metric.status_class == '5xx' | align rate(1h) | every 5m | group_by [], [value: sum(val())] ; total: fetch prometheus_target :: 'prometheus.googleapis.com/http_server_requests_total/counter' | align rate(1h) | every 5m | group_by [], [value: sum(val())] } | join | value (val(0) / val(1)) / 0.005"
          }
        },
        {
          "refId": "B",
          "datasource": "Google Cloud Monitoring",
          "aliasBy": "6h burn rate",
          "queryType": "timeSeriesQuery",
          "timeSeriesQuery": {
            "projectName": "goatos-stg",
            "query": "{ err: fetch prometheus_target :: 'prometheus.googleapis.com/http_server_requests_total/counter' | filter metric.status_class == '5xx' | align rate(6h) | every 5m | group_by [], [value: sum(val())] ; total: fetch prometheus_target :: 'prometheus.googleapis.com/http_server_requests_total/counter' | align rate(6h) | every 5m | group_by [], [value: sum(val())] } | join | value (val(0) / val(1)) / 0.005"
          }
        }
      ]
    },
    {
