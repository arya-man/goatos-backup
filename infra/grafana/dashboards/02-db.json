{
  "uid": "goatos-stg-db",
  "title": "Goat OS \u2014 Database APM",
  "description": "Database health dashboard. The first row uses live Cloud SQL native metrics (CPU, memory, disk, active backends, disk IO) that are visible today. App pgx pool/query-duration panels remain below and require backend OTEL/GMP DB instrumentation; those are useful for table-level choke points once emitted.",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "timezone": "Asia/Kolkata",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "tags": [
    "goatos",
    "db",
    "cloud-sql"
  ],
  "panels": [
    {
      "id": 100,
      "title": "App DB pool and query instrumentation (requires app metrics)",
      "type": "row",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 15
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 1,
      "title": "Pool saturation: in-use / idle / max / pending",
      "description": "db.client.connections.usage/idle/max/pending from pgxpool.Stat(), registered once per pool by postgres.RegisterPoolMetrics. 'pending' is the closest pgxpool gauge to acquire-wait pressure (connections currently being constructed) \u2014 pgxpool only exposes cumulative counters for actual wait events, not a live waiter gauge.",
      "type": "timeseries",
      "gridPos": {
        "h": 9,
        "w": 16,
        "x": 0,
        "y": 16
      },
      "datasource": "Google Cloud Monitoring",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 15,
            "lineWidth": 1,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "max"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "dash": [
                    10,
                    10
                  ],
                  "fill": "dash"
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "in use"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": "Google Cloud Monitoring",
          "aliasBy": "in use",
          "queryType": "timeSeriesList",
          "timeSeriesList": {
            "projectName": "goatos-stg",
            "view": "FULL",
            "perSeriesAligner": "ALIGN_MEAN",
            "crossSeriesReducer": "REDUCE_SUM",
            "alignmentPeriod": "60s",
            "filters": ["metric.type", "=", "prometheus.googleapis.com/db_client_connections_usage/gauge", "AND", "resource.type", "=", "prometheus_target"]
          }
        },
        {
          "refId": "B",
          "datasource": "Google Cloud Monitoring",
          "aliasBy": "idle",
          "queryType": "timeSeriesList",
          "timeSeriesList": {
            "projectName": "goatos-stg",
            "view": "FULL",
            "perSeriesAligner": "ALIGN_MEAN",
            "crossSeriesReducer": "REDUCE_SUM",
            "alignmentPeriod": "60s",
            "filters": ["metric.type", "=", "prometheus.googleapis.com/db_client_connections_idle/gauge", "AND", "resource.type", "=", "prometheus_target"]
          }
        },
        {
          "refId": "C",
          "datasource": "Google Cloud Monitoring",
          "aliasBy": "max",
          "queryType": "timeSeriesList",
          "timeSeriesList": {
            "projectName": "goatos-stg",
            "view": "FULL",
            "perSeriesAligner": "ALIGN_MEAN",
            "crossSeriesReducer": "REDUCE_SUM",
            "alignmentPeriod": "60s",
            "filters": ["metric.type", "=", "prometheus.googleapis.com/db_client_connections_max/gauge", "AND", "resource.type", "=", "prometheus_target"]
          }
        },
        {
          "refId": "D",
          "datasource": "Google Cloud Monitoring",
          "aliasBy": "pending (constructing)",
          "queryType": "timeSeriesList",
          "timeSeriesList": {
            "projectName": "goatos-stg",
            "view": "FULL",
            "perSeriesAligner": "ALIGN_MEAN",
            "crossSeriesReducer": "REDUCE_SUM",
            "alignmentPeriod": "60s",
            "filters": ["metric.type", "=", "prometheus.googleapis.com/db_client_connections_pending/gauge", "AND", "resource.type", "=", "prometheus_target"]
          }
        }
      ]
    },
    {
      "id": 2,
      "title": "Pool utilization % (in-use / max)",
      "description": "MQL ratio: 100 * db_client_connections_usage / db_client_connections_max. Amber at 70%, red at 90% \u2014 the same shape of headroom check used for Cloud SQL CPU (80%) below.",
      "type": "stat",
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 16,
        "y": 16
      },
      "datasource": "Google Cloud Monitoring",
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 70
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "graphMode": "area",
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": "Google Cloud Monitoring",
          "queryType": "timeSeriesQuery",
          "timeSeriesQuery": {
            "projectName": "goatos-stg",
            "query": "{ used: fetch prometheus_target :: 'prometheus.googleapis.com/db_client_connections_usage/gauge' | group_by [], [value: sum(val())] ; max: fetch prometheus_target :: 'prometheus.googleapis.com/db_client_connections_max/gauge' | group_by [], [value: sum(val())] } | join | value 100 * val(0) / val(1)"
          }
        }
      ]
    },
    {
      "id": 101,
      "title": "Query duration (pending pgx tracer \u2014 section 2.2)",
      "type": "row",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 10
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 3,
      "title": "Query duration p50 / p95 / p99 by pgx operation",
      "description": "Live otelpgx db.client.operation.duration histogram from Cloud Monitoring. It currently groups by `pgx_operation_type` (acquire/connect/prepare/query/batch); table-level attribution remains a follow-up because the emitted metric labels do not include a stable table label.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 26
      },
      "datasource": "Google Cloud Monitoring",
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 5,
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": "Google Cloud Monitoring",
          "aliasBy": "p50 {{metric.label.pgx_operation_type}}",
          "queryType": "timeSeriesList",
          "timeSeriesList": {
            "projectName": "goatos-stg",
            "view": "FULL",
            "groupBys": [
              "metric.label.pgx_operation_type"
            ],
            "perSeriesAligner": "ALIGN_DELTA",
            "crossSeriesReducer": "REDUCE_PERCENTILE_50",
            "alignmentPeriod": "300s",
            "filters": ["metric.type", "=", "prometheus.googleapis.com/db_client_operation_duration_seconds/histogram", "AND", "resource.type", "=", "prometheus_target"]
          }
        },
        {
          "refId": "B",
          "datasource": "Google Cloud Monitoring",
          "aliasBy": "p95 {{metric.label.pgx_operation_type}}",
          "queryType": "timeSeriesList",
          "timeSeriesList": {
            "projectName": "goatos-stg",
            "view": "FULL",
            "groupBys": [
              "metric.label.pgx_operation_type"
            ],
            "perSeriesAligner": "ALIGN_DELTA",
            "crossSeriesReducer": "REDUCE_PERCENTILE_95",
            "alignmentPeriod": "300s",
            "filters": ["metric.type", "=", "prometheus.googleapis.com/db_client_operation_duration_seconds/histogram", "AND", "resource.type", "=", "prometheus_target"]
          }
        },
        {
          "refId": "C",
          "datasource": "Google Cloud Monitoring",
          "aliasBy": "p99 {{metric.label.pgx_operation_type}}",
          "queryType": "timeSeriesList",
          "timeSeriesList": {
            "projectName": "goatos-stg",
            "view": "FULL",
            "groupBys": [
              "metric.label.pgx_operation_type"
            ],
            "perSeriesAligner": "ALIGN_DELTA",
            "crossSeriesReducer": "REDUCE_PERCENTILE_99",
            "alignmentPeriod": "300s",
            "filters": ["metric.type", "=", "prometheus.googleapis.com/db_client_operation_duration_seconds/histogram", "AND", "resource.type", "=", "prometheus_target"]
          }
        }
      ]
    },
    {
      "id": 4,
      "title": "Query event rate by pgx operation",
      "description": "Rate view of the live otelpgx duration histogram, grouped by `pgx_operation_type`.",
      "type": "timeseries",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 34
      },
      "datasource": "Google Cloud Monitoring",
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": "Google Cloud Monitoring",
          "aliasBy": "{{metric.label.pgx_operation_type}}",
          "queryType": "timeSeriesQuery",
          "timeSeriesQuery": {
            "projectName": "goatos-stg",
            "query": "fetch prometheus_target :: 'prometheus.googleapis.com/db_client_operation_duration_seconds/histogram' | value [value: count_from(val())] | align rate(5m) | every 5m | group_by [metric.pgx_operation_type], [value: sum(val())]"
          }
        }
      ]
    },
    {
      "id": 5,
      "title": "Query duration p99 by pgx operation",
      "description": "Reduced-to-latest p99 by `pgx_operation_type`. Table/query plan attribution is still handled in Cloud Trace / Query Insights until a low-cardinality operation/table label is added to DB metrics.",
      "type": "table",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 34
      },
      "datasource": "Google Cloud Monitoring",
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "transformations": [
        {
          "id": "reduce",
          "options": {
            "reducers": [
              "lastNotNull"
            ],
            "includeTimeField": false
          }
        },
        {
          "id": "sortBy",
          "options": {
            "fields": {},
            "sort": [
              {
                "field": "Last *",
                "desc": true
              }
            ]
          }
        },
        {
          "id": "limit",
          "options": {
            "limitField": 10
          }
        }
      ],
      "targets": [
        {
          "refId": "A",
          "datasource": "Google Cloud Monitoring",
          "aliasBy": "{{metric.label.pgx_operation_type}}",
          "queryType": "timeSeriesList",
          "timeSeriesList": {
            "projectName": "goatos-stg",
            "view": "FULL",
            "groupBys": [
              "metric.label.pgx_operation_type"
            ],
            "perSeriesAligner": "ALIGN_DELTA",
            "crossSeriesReducer": "REDUCE_PERCENTILE_99",
            "alignmentPeriod": "300s",
            "filters": ["metric.type", "=", "prometheus.googleapis.com/db_client_operation_duration_seconds/histogram", "AND", "resource.type", "=", "prometheus_target"]
          }
        }
      ]
    },
