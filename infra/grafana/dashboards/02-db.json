{
  "uid": "goatos-stg-db",
  "title": "Goat OS stg — Database APM",
  "description": "pgx query duration + pool saturation (OTel via GMP, queried through the 'Google Cloud Monitoring' stackdriver datasource — no Prometheus datasource in this environment) alongside native Cloud SQL infra metrics for goatos-stg-core-db. IMPORTANT: db.client.operation.duration (query p50/p95/p99 by operation/table) is documented in OBSERVABILITY_DESIGN.md section 2.1 but NOT YET emitted by backend/internal/platform/postgres — only the four pgxpool.Stat() gauges (db.client.connections.usage/idle/max/pending, wired in postgres/metrics.go RegisterPoolMetrics) are live today. The query-duration panels are correct-shape placeholders for when the pgx tracer (section 2.2) lands; pool-saturation and Cloud SQL panels are queryable now.",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "timezone": "Asia/Kolkata",
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "30s",
  "tags": ["goatos", "stg", "db", "cloud-sql"],
  "panels": [
    {
      "id": 100,
      "title": "Connection pool (live: RegisterPoolMetrics)",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 1,
      "title": "Pool saturation: in-use / idle / max / pending",
      "description": "db.client.connections.usage/idle/max/pending from pgxpool.Stat(), registered once per pool by postgres.RegisterPoolMetrics. 'pending' is the closest pgxpool gauge to acquire-wait pressure (connections currently being constructed) — pgxpool only exposes cumulative counters for actual wait events, not a live waiter gauge.",
      "type": "timeseries",
      "gridPos": { "h": 9, "w": 16, "x": 0, "y": 1 },
      "datasource": "Google Cloud Monitoring",
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 15, "lineWidth": 1, "stacking": { "mode": "none" } } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "max" }, "properties": [{ "id": "custom.lineStyle", "value": { "dash": [10, 10], "fill": "dash" } }, { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }] },
          { "matcher": { "id": "byName", "options": "in use" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "blue" } }] }
        ]
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "refId": "A",
          "datasource": "Google Cloud Monitoring",
          "aliasBy": "in use",
          "queryType": "timeSeriesList",
          "timeSeriesList": {
            "projectName": "goatos-stg",
            "filters": ["metric.type", "=", "prometheus.googleapis.com/db_client_connections_usage/gauge", "AND", "resource.type", "=", "generic_task"],
            "view": "FULL",
            "perSeriesAligner": "ALIGN_MEAN",
            "crossSeriesReducer": "REDUCE_SUM",
            "alignmentPeriod": "60s"
          }
        },
        {
          "refId": "B",
          "datasource": "Google Cloud Monitoring",
          "aliasBy": "idle",
          "queryType": "timeSeriesList",
          "timeSeriesList": {
            "projectName": "goatos-stg",
            "filters": ["metric.type", "=", "prometheus.googleapis.com/db_client_connections_idle/gauge", "AND", "resource.type", "=", "generic_task"],
            "view": "FULL",
            "perSeriesAligner": "ALIGN_MEAN",
            "crossSeriesReducer": "REDUCE_SUM",
            "alignmentPeriod": "60s"
          }
        },
        {
          "refId": "C",
          "datasource": "Google Cloud Monitoring",
          "aliasBy": "max",
          "queryType": "timeSeriesList",
          "timeSeriesList": {
            "projectName": "goatos-stg",
            "filters": ["metric.type", "=", "prometheus.googleapis.com/db_client_connections_max/gauge", "AND", "resource.type", "=", "generic_task"],
            "view": "FULL",
            "perSeriesAligner": "ALIGN_MEAN",
            "crossSeriesReducer": "REDUCE_SUM",
            "alignmentPeriod": "60s"
          }
        },
        {
          "refId": "D",
          "datasource": "Google Cloud Monitoring",
          "aliasBy": "pending (constructing)",
          "queryType": "timeSeriesList",
          "timeSeriesList": {
            "projectName": "goatos-stg",
            "filters": ["metric.type", "=", "prometheus.googleapis.com/db_client_connections_pending/gauge", "AND", "resource.type", "=", "generic_task"],
            "view": "FULL",
            "perSeriesAligner": "ALIGN_MEAN",
            "crossSeriesReducer": "REDUCE_SUM",
            "alignmentPeriod": "60s"
          }
        }
      ]
    },
    {
      "id": 2,
      "title": "Pool utilization % (in-use / max)",
      "description": "MQL ratio: 100 * db_client_connections_usage / db_client_connections_max. Amber at 70%, red at 90% — the same shape of headroom check used for Cloud SQL CPU (80%) below.",
      "type": "stat",
      "gridPos": { "h": 9, "w": 8, "x": 16, "y": 1 },
      "datasource": "Google Cloud Monitoring",
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 70 }, { "color": "red", "value": 90 }] }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "area", "textMode": "value_and_name" },
      "targets": [
        {
          "refId": "A",
          "datasource": "Google Cloud Monitoring",
          "queryType": "timeSeriesQuery",
          "timeSeriesQuery": {
            "projectName": "goatos-stg",
            "query": "{ used: fetch generic_task :: 'prometheus.googleapis.com/db_client_connections_usage/gauge' | group_by [], [value: sum(val())] ; max: fetch generic_task :: 'prometheus.googleapis.com/db_client_connections_max/gauge' | group_by [], [value: sum(val())] } | join | value 100 * val(0) / val(1)"
          }
        }
      ]
    },
    {
      "id": 101,
      "title": "Query duration (pending pgx tracer — section 2.2)",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 10 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 3,
      "title": "Query duration p50 / p95 / p99 by operation",
      "description": "db.client.operation.duration histogram, labels operation,table — NOT YET emitted (postgres/metrics.go only wires pool gauges today; the otelpgx query tracer is a documented follow-up in OBSERVABILITY_DESIGN.md section 2.2). Query is correct and will populate once the tracer ships. p95 stands in for the requested p90 (Cloud Monitoring has no p90 aligner).",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 11 },
      "datasource": "Google Cloud Monitoring",
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 5, "lineWidth": 1 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "refId": "A",
          "datasource": "Google Cloud Monitoring",
          "aliasBy": "p50 {{metric.label.operation}}",
          "queryType": "timeSeriesList",
          "timeSeriesList": {
            "projectName": "goatos-stg",
            "filters": ["metric.type", "=", "prometheus.googleapis.com/db_client_operation_duration_seconds/histogram", "AND", "resource.type", "=", "generic_task"],
            "view": "FULL",
            "groupBys": ["metric.label.operation"],
            "perSeriesAligner": "ALIGN_PERCENTILE_50",
            "crossSeriesReducer": "REDUCE_NONE",
            "alignmentPeriod": "300s"
          }
        },
        {
          "refId": "B",
          "datasource": "Google Cloud Monitoring",
          "aliasBy": "p95 {{metric.label.operation}}",
          "queryType": "timeSeriesList",
          "timeSeriesList": {
            "projectName": "goatos-stg",
            "filters": ["metric.type", "=", "prometheus.googleapis.com/db_client_operation_duration_seconds/histogram", "AND", "resource.type", "=", "generic_task"],
            "view": "FULL",
            "groupBys": ["metric.label.operation"],
            "perSeriesAligner": "ALIGN_PERCENTILE_95",
            "crossSeriesReducer": "REDUCE_NONE",
            "alignmentPeriod": "300s"
          }
        },
        {
          "refId": "C",
          "datasource": "Google Cloud Monitoring",
          "aliasBy": "p99 {{metric.label.operation}}",
          "queryType": "timeSeriesList",
          "timeSeriesList": {
            "projectName": "goatos-stg",
            "filters": ["metric.type", "=", "prometheus.googleapis.com/db_client_operation_duration_seconds/histogram", "AND", "resource.type", "=", "generic_task"],
            "view": "FULL",
            "groupBys": ["metric.label.operation"],
            "perSeriesAligner": "ALIGN_PERCENTILE_99",
            "crossSeriesReducer": "REDUCE_NONE",
            "alignmentPeriod": "300s"
          }
        }
      ]
    },
    {
      "id": 4,
      "title": "Query rate by operation",
      "description": "count-rate view of db.client.operation.duration (histogram _count series doubles as a request-rate signal). Pending pgx tracer, same as above.",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 19 },
      "datasource": "Google Cloud Monitoring",
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 1 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "refId": "A",
          "datasource": "Google Cloud Monitoring",
          "aliasBy": "{{metric.label.operation}}",
          "queryType": "timeSeriesList",
          "timeSeriesList": {
            "projectName": "goatos-stg",
            "filters": ["metric.type", "=", "prometheus.googleapis.com/db_client_operation_duration_seconds/histogram", "AND", "resource.type", "=", "generic_task"],
            "view": "FULL",
            "groupBys": ["metric.label.operation"],
            "perSeriesAligner": "ALIGN_RATE",
            "crossSeriesReducer": "REDUCE_NONE",
            "alignmentPeriod": "300s"
          }
        }
      ]
    },
    {
      "id": 5,
      "title": "Query duration p99 by table (top 10)",
      "description": "Reduced-to-latest p99 by table, sorted descending — the query-plan equivalent of the API dashboard's top-slow-routes table. Pending pgx tracer.",
      "type": "table",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 19 },
      "datasource": "Google Cloud Monitoring",
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "transformations": [
        { "id": "reduce", "options": { "reducers": ["lastNotNull"], "includeTimeField": false } },
        { "id": "sortBy", "options": { "fields": {}, "sort": [{ "field": "Last *", "desc": true }] } },
        { "id": "limit", "options": { "limitField": 10 } }
      ],
      "targets": [
        {
          "refId": "A",
          "datasource": "Google Cloud Monitoring",
          "aliasBy": "{{metric.label.table}}",
          "queryType": "timeSeriesList",
          "timeSeriesList": {
            "projectName": "goatos-stg",
            "filters": ["metric.type", "=", "prometheus.googleapis.com/db_client_operation_duration_seconds/histogram", "AND", "resource.type", "=", "generic_task"],
            "view": "FULL",
            "groupBys": ["metric.label.table"],
            "perSeriesAligner": "ALIGN_PERCENTILE_99",
            "crossSeriesReducer": "REDUCE_NONE",
            "alignmentPeriod": "300s"
          }
        }
      ]
    },
    {
      "id": 102,
      "title": "Cloud SQL infra (goatos-stg-core-db)",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 26 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 6,
      "title": "Cloud SQL CPU utilization",
      "description": "cloudsql.googleapis.com/database/cpu/utilization. Red threshold at 80% matches the cloud_sql_cpu alert policy in monitoring.tf.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 27 },
      "datasource": "Google Cloud Monitoring",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit", "max": 1, "min": 0,
          "custom": { "drawStyle": "line", "fillOpacity": 15, "lineWidth": 1, "thresholdsStyle": { "mode": "line" } },
