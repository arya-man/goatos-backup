          "queryType": "timeSeriesList",
          "timeSeriesList": {
            "projectName": "goatos-stg",
            "filters": ["metric.type", "=", "cloudsql.googleapis.com/database/disk/utilization", "AND", "resource.label.database_id", "=", "goatos-stg:goatos-stg-core-db"],
