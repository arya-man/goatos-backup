          "datasource": "Google Cloud Monitoring",
          "queryType": "timeSeriesList",
          "timeSeriesList": {
            "projectName": "goatos-stg",
            "filters": ["metric.type", "=", "cloudsql.googleapis.com/database/cpu/utilization", "AND", "resource.label.database_id", "=", "goatos-stg:goatos-stg-core-db"],
            "view": "FULL",
            "perSeriesAligner": "ALIGN_MEAN",
            "crossSeriesReducer": "REDUCE_NONE",
            "alignmentPeriod": "60s"
          }
        }
