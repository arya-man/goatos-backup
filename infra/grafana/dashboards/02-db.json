    {
      "id": 8,
      "title": "Cloud SQL disk utilization",
      "description": "cloudsql.googleapis.com/database/disk/utilization — not previously charted; added so storage pressure is visible alongside CPU/memory rather than discovered only via an outage.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 27 },
      "datasource": "Google Cloud Monitoring",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit", "max": 1, "min": 0,
