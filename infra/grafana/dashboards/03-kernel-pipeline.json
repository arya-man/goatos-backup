{
  "uid": "goatos-stg-kernel-pipeline",
  "title": "Goat OS stg \u2014 Kernel pipeline",
  "description": "One row per operational-kernel stage, mirroring the golden chain event -> txn -> audit/outbox -> trigger -> obligation -> sweeper -> notify -> proof (context/architecture/operational-kernel.md). Metric names verified against backend/internal/platform/kmetrics/*.go and cross-checked against the exact GMP metric.type strings already used by infra/envs/stg/monitoring.tf alert policies. Queried through the 'Google Cloud Monitoring' (stackdriver) datasource \u2014 this environment has no Prometheus datasource. Pub/Sub backlog comes free from native pubsub.googleapis.com metrics (no OTel instrumentation needed). An operator should be able to look at the top summary row alone and know WHERE the pipeline is backed up.",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "timezone": "Asia/Kolkata",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "tags": [
    "goatos",
    "stg",
    "kernel",
    "outbox",
    "obligations",
    "pipeline"
  ],
  "panels": [
    {
      "id": 200,
      "title": "Pipeline health \u2014 at a glance",
      "type": "row",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 1,
      "title": "Outbox queue depth",
      "description": "kernel.outbox.queue_depth (gauge) \u2014 rows claimed in the most recent relay batch, a proxy for queue depth (a true COUNT(*) is intentionally avoided on the hot path). Green under 50, amber to 200, red above \u2014 tune once a real baseline is observed.",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "datasource": "Google Cloud Monitoring",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 50
              },
              {
                "color": "red",
                "value": 200
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "graphMode": "area",
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": "Google Cloud Monitoring",
          "queryType": "timeSeriesList",
          "timeSeriesList": {
            "projectName": "goatos-stg",
            "filters": [
              "metric.type",
              "=",
              "prometheus.googleapis.com/kernel_outbox_queue_depth/gauge",
              "AND",
              "resource.type",
              "=",
              "generic_task"
            ],
            "view": "FULL",
            "perSeriesAligner": "ALIGN_MAX",
            "crossSeriesReducer": "REDUCE_SUM",
            "alignmentPeriod": "60s"
          }
        }
      ]
    },
    {
      "id": 2,
      "title": "DLQ backlog (dead-lettered, undelivered)",
      "description": "pubsub.googleapis.com/subscription/num_undelivered_messages on goatos-stg-outbox-events-dlq-inspect \u2014 the true dead-letter inspection subscription (native GCP metric, free). Any value > 0 for 5m pages ops via the pubsub_dlq_backlog alert policy in monitoring.tf, so red starts at 1, not a softer threshold.",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "datasource": "Google Cloud Monitoring",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "graphMode": "area",
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": "Google Cloud Monitoring",
          "queryType": "timeSeriesList",
          "timeSeriesList": {
            "projectName": "goatos-stg",
            "filters": [
              "metric.type",
              "=",
              "pubsub.googleapis.com/subscription/num_undelivered_messages",
              "AND",
              "resource.label.subscription_id",
              "=",
