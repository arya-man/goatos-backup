          "timeSeriesList": {
            "projectName": "goatos-stg",
            "view": "FULL",
            "perSeriesAligner": "ALIGN_DELTA",
            "crossSeriesReducer": "REDUCE_SUM",
            "alignmentPeriod": "300s",
            "filters": ["metric.type", "=", "logging.googleapis.com/user/goatos_kernel_outbox_reclaimed", "AND", "resource.type", "=", "cloud_run_job"],
