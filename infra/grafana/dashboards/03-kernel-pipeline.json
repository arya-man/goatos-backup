          "timeSeriesQuery": {
            "projectName": "goatos-stg",
            "query": "{ outbox: fetch generic_task :: 'prometheus.googleapis.com/kernel_outbox_publish_duration_seconds/histogram' | align delta(5m) | every 5m | group_by [], [value: percentile(val(), 99)] ; consume: fetch generic_task :: 'prometheus.googleapis.com/kernel_consumer_handle_duration_seconds/histogram' | align delta(5m) | every 5m | group_by [], [value: percentile(val(), 99)] ; sweep: fetch generic_task :: 'prometheus.googleapis.com/kernel_sweeper_batch_duration_seconds/histogram' | align delta(5m) | every 5m | group_by [], [value: percentile(val(), 99)] } | join | value val(0) + val(1) + val(2)"
