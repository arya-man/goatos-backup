      ]
    },
    {
      "id": 4,
      "title": "Notification failure rate",
      "description": "MQL ratio: 100 * rate(kernel.notify.failures) / rate(kernel.notify.send.duration count). SLO success > 99% (notification_success_slo_ratio); red at the 1% alert threshold used by kernel_notification_failure_rate in monitoring.tf.",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "datasource": "Google Cloud Monitoring",
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 10,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.5
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "graphMode": "area",
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": "Google Cloud Monitoring",
          "queryType": "timeSeriesQuery",
          "timeSeriesQuery": {
            "projectName": "goatos-stg",
            "query": "{ fail: fetch prometheus_target :: 'prometheus.googleapis.com/kernel_notify_failures_total/counter' | align rate(15m) | every 5m | group_by [], [value: sum(val())] ; sent: fetch prometheus_target :: 'prometheus.googleapis.com/kernel_notify_send_duration_seconds/histogram' | value [value: count_from(val())] | align rate(15m) | every 5m | group_by [], [value: sum(val())] } | join | value 100 * val(0) / val(1)"
          }
        }
      ]
    },
    {
      "id": 201,
      "title": "Stage 1 \u2014 Outbox relay (audit -> publish)",
      "type": "row",
      "gridPos": {
        "h": 1,
        "w": 24,
