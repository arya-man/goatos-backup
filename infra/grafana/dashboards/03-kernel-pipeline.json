{
  "uid": "goatos-stg-kernel-pipeline",
  "title": "Goat OS \u2014 Kernel pipeline",
  "description": "One row per operational-kernel stage, mirroring the golden chain event -> txn -> audit/outbox -> trigger -> obligation -> sweeper -> notify -> proof (context/architecture/operational-kernel.md). Metric names verified against backend/internal/platform/kmetrics/*.go and cross-checked against the exact GMP metric.type strings already used by infra/envs/stg/monitoring.tf alert policies. Queried through the 'Google Cloud Monitoring' (stackdriver) datasource \u2014 this environment has no Prometheus datasource. Pub/Sub backlog comes free from native pubsub.googleapis.com metrics (no OTel instrumentation needed). An operator should be able to look at the top summary row alone and know WHERE the pipeline is backed up.",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "timezone": "Asia/Kolkata",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "tags": [
    "goatos",
    "kernel",
    "outbox",
    "obligations",
    "pipeline"
  ],
  "panels": [
    {
      "id": 200,
      "title": "Pipeline health \u2014 at a glance",
      "type": "row",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 1,
      "title": "Outbox queue depth",
      "description": "kernel.outbox.queue_depth (gauge) \u2014 rows claimed in the most recent relay batch, a proxy for queue depth (a true COUNT(*) is intentionally avoided on the hot path). Green under 50, amber to 200, red above \u2014 tune once a real baseline is observed.",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "datasource": "Google Cloud Monitoring",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 50
              },
              {
                "color": "red",
                "value": 200
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "graphMode": "area",
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": "Google Cloud Monitoring",
          "queryType": "timeSeriesList",
          "timeSeriesList": {
            "projectName": "goatos-stg",
            "view": "FULL",
            "perSeriesAligner": "ALIGN_MAX",
            "crossSeriesReducer": "REDUCE_SUM",
            "alignmentPeriod": "60s",
            "filters": ["metric.type", "=", "prometheus.googleapis.com/kernel_outbox_queue_depth/gauge", "AND", "resource.type", "=", "prometheus_target"]
          }
        }
      ]
    },
    {
      "id": 2,
      "title": "Domain-events undelivered messages",
      "description": "Actual goatos-stg-domain-events subscription. The staging DLQ inspection subscription is not configured; these values are primary-subscription health, not a dead-letter backlog.",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "datasource": "Google Cloud Monitoring",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "graphMode": "area",
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": "Google Cloud Monitoring",
          "queryType": "timeSeriesList",
          "timeSeriesList": {
            "projectName": "goatos-stg",
            "view": "FULL",
            "perSeriesAligner": "ALIGN_MAX",
            "crossSeriesReducer": "REDUCE_SUM",
            "alignmentPeriod": "60s",
            "filters": ["resource.type", "=", "pubsub_subscription", "AND", "metric.type", "=", "pubsub.googleapis.com/subscription/num_undelivered_messages", "AND", "resource.label.subscription_id", "=", "goatos-stg-domain-events"]
          },
          "aliasBy": "domain-events"
        }
      ]
    },
    {
      "id": 3,
      "title": "Consumer lag",
      "description": "kernel.consumer.lag (gauge, seconds) \u2014 age of a domain event at handle time. SLO 60s (consumer_lag_slo_seconds in variables.tf); the kernel_consumer_lag alert policy pages above this.",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "datasource": "Google Cloud Monitoring",
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 30
              },
              {
                "color": "red",
                "value": 60
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "graphMode": "area",
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": "Google Cloud Monitoring",
          "queryType": "timeSeriesList",
          "timeSeriesList": {
            "projectName": "goatos-stg",
            "view": "FULL",
            "perSeriesAligner": "ALIGN_MAX",
            "crossSeriesReducer": "REDUCE_MAX",
            "alignmentPeriod": "60s",
            "filters": ["metric.type", "=", "prometheus.googleapis.com/kernel_consumer_lag_seconds/gauge", "AND", "resource.type", "=", "prometheus_target"]
          }
