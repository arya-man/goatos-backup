    {
      "id": 5,
      "title": "Publish duration p50 / p99 by outcome",
      "description": "kernel.outbox.publish.duration, labels outcome (published/retry_scheduled/failed/dead_letter), event_type. One instrument covers success and failure so a single histogram tells you both latency and where messages are going.",
      "type": "timeseries",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "datasource": "Google Cloud Monitoring",
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 5,
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": "Google Cloud Monitoring",
          "aliasBy": "p50 {{metric.label.outcome}}",
          "queryType": "timeSeriesList",
          "timeSeriesList": {
            "projectName": "goatos-stg",
            "view": "FULL",
            "groupBys": [
              "metric.label.outcome"
            ],
            "perSeriesAligner": "ALIGN_DELTA",
            "crossSeriesReducer": "REDUCE_PERCENTILE_50",
            "alignmentPeriod": "300s",
            "filters": ["metric.type", "=", "prometheus.googleapis.com/kernel_outbox_publish_duration_seconds/histogram", "AND", "resource.type", "=", "prometheus_target"]
          }
        },
        {
          "refId": "B",
          "datasource": "Google Cloud Monitoring",
          "aliasBy": "p99 {{metric.label.outcome}}",
          "queryType": "timeSeriesList",
          "timeSeriesList": {
            "projectName": "goatos-stg",
            "view": "FULL",
            "groupBys": [
              "metric.label.outcome"
            ],
            "perSeriesAligner": "ALIGN_DELTA",
            "crossSeriesReducer": "REDUCE_PERCENTILE_99",
            "alignmentPeriod": "300s",
            "filters": ["metric.type", "=", "prometheus.googleapis.com/kernel_outbox_publish_duration_seconds/histogram", "AND", "resource.type", "=", "prometheus_target"]
          }
        }
      ]
    },
    {
      "id": 6,
      "title": "Outbox throughput: reclaimed / retry-scheduled / dead-lettered",
      "description": "kernel.outbox.reclaimed (stale lease recovery), kernel.outbox.retry_scheduled, kernel.outbox.dead_letters \u2014 all counters, rate/5m. A rising dead-letter line with flat reclaimed/retry means messages are failing outright, not just slow to land.",
