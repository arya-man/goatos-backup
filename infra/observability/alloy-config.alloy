// Browser RUM: Faro JSON logs -> OTLP logs -> Cloud Logging; traces -> Cloud Trace.
// Keep the receiver on8080 and Alloy's own controlplane on loopback12345.
faro.receiver "admin_web_rum" {
  log_format = "json"
  server {
    listen_address = "0.0.0.0"
    listen_port = 8080
    cors_allowed_origins = ["https://dashboard.mesha.sg", "https://stg.dashboard.mesha.sg"]
    max_allowed_payload_size = "1MiB"
    rate_limiting {
      rate = 50
      burst_size = 100
    }
  }
  // Never fetch arbitrary browser-supplied sourcemap URLs.
  sourcemaps {
    download = false
  }
  output {
    logs = [otelcol.receiver.loki.faro.receiver]
    traces = [otelcol.exporter.googlecloud.default.input]
  }
}

otelcol.receiver.loki "faro" {
  output {
    logs = [otelcol.processor.transform.faro_json.input]
  }
}

// A map body becomes jsonPayload in Cloud Logging; dashboards and log metrics
// query bounded scalar keys (kind/type/value_lcp), not arbitrary log text.
otelcol.processor.transform "faro_json" {
  error_mode = "propagate"
  log_statements {
    context = "log"
    statements = [
      `set(body, ParseJSON(body)) where IsString(body)`,
    ]
  }
  output {
    logs = [otelcol.exporter.googlecloud.default.input]
  }
}

otelcol.exporter.googlecloud "default" {
  project = "goatos-stg"
  log {
    default_log_name = "goatos-stg-faro"
  }
}
