{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goatos.local/contracts/jsonschema/sop-proof-policy.schema.json",
  "title": "Goat OS SOP Proof Policy",
  "type": "object",
  "required": ["required", "subject_scope", "types", "minimum_count"],
  "not": { "required": ["scope"] },
  "additionalProperties": true,
  "properties": {
    "required": { "type": "boolean" },
    "subject_scope": { "enum": ["batch", "goat", "shed", "task"] },
    "types": {
      "type": "array",
      "minItems": 1,
      "items": { "enum": ["photo", "video"] }
    },
    "minimum_count": { "type": "integer", "minimum": 0 },
    "minimum_count_per_subject": { "type": "integer", "minimum": 0 },
    "maximum_count_per_subject": { "type": "integer", "minimum": 0 },
    "capture_source": { "enum": ["in_app_camera"] },
    "verify_before_apply": { "type": "boolean" },
    "retention_policy": {
      "type": "string",
      "enum": ["operational_90d", "standard_1y", "critical_7y", "legal_hold"]
    }
  }
}
