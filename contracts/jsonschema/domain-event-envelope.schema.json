{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.goatos.local/jsonschema/domain-event-envelope.schema.json",
  "title": "Goat OS Domain Event Envelope",
  "description": "Shared envelope for Phase 1 Goat Passport domain/outbox events.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "event_type",
    "schema_version",
    "schema_ref",
    "aggregate_type",
    "aggregate_id",
    "occurred_at",
    "recorded_at",
    "producer",
    "idempotency_key",
    "actor",
    "subject_type",
    "subject_id",
    "visibility_scope",
    "evidence_refs",
    "payload",
    "trace_id"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "goat.created",
        "goat.identity.updated",
        "goat.identifier.added",
        "goat.identifier.retired",
        "goat.identifier.disputed",
        "goat.identity.conflict_opened",
        "goat.identity.conflict_resolved",
        "goat.identity.merge_proposed",
        "goat.identity.merge_approved",
        "goat.identity.merge_rejected",
        "goat.exited",
        "goat.location.changed",
        "goat.stage_changed",
        "goat.health.changed",
        "health.protocol.published",
        "health.observation.submitted",
        "health.diagnosis.confirmed",
        "health.case.opened",
        "health.case.death_held",
        "health.case.death_resumed",
        "health.case.closed_dead",
        "health.case.closed",
        "health.treatment.completed",
        "goat.reproductive.changed",
        "goat.identity.changed",
        "goat.shifted",
        "identity.correction_request.created",
        "identity.correction_request.updated",
        "calendar.nudge.requested",
        "calendar.reminder.queued",
        "calendar.reminder.cadence.queued",
        "calendar.escalation.queued",
        "calendar.snooze.recorded",
        "calendar.escalation.acknowledged",
        "calendar.escalation.resolved",
        "notification.exhausted",
        "notification.sent",
        "obligation.in_progress",
        "obligation.missed",
        "obligation.rescoped",
        "obligation.reopened",
        "goat.obligations_canceled",
        "vaccination.verify.accepted",
        "vaccination.verify.rejected",
        "vaccination.completed",
        "protocol.version.published",
        "protocol.version.retired",
        "config.changed",
        "counts.base_count_anchor.recorded",
        "counts.shifting_event.recorded",
        "counts.projection_exception.opened",
        "counts.death.reported",
        "counts.death.rejected",
        "verification.item.pending",
        "verification.verdict.rework",
        "verification.verdict.approved",
        "verification.item.closed",
        "verification.vaccination_drive.ready",
        "verification.vaccination_drive.closed",
        "weighing.campaign_created",
        "weighing.campaign_updated",
        "weighing.campaign_published",
        "weighing.observation_accepted",
        "weighing.shed_observation_accepted",
        "weighing.shed_submission.completed",
        "weighing.shed.abandoned",
        "weighing.shed.reopened",
        "weighing.shed.closed",
        "weighing.observation.verified",
        "weighing.observation.rework",
        "weighing.observation.rework_digest",
        "weighing.campaign.closed",
        "weighing.shed.verified_closed",
        "weighing.campaign.verified_closed",
        "weighing.work_item.day_start",
        "weighing.work_item.rolled_forward",
        "weighing.work_item.merged_on_carry_over",
        "weighing.work_item.delayed",
        "counts.projection_exception.updated",
        "counts.projection_exception.closed",
        "feed.direction.completed",
        "feed.distribution.completed",
        "feed.packing.completed",
        "feed.packing.reopened",
        "feed.wastage.completed",
        "pc_care.task.pending_verification",
        "pc_care.task.completed",
        "vaccination.capacity.changed",
        "vaccination.roster.changed",
        "vaccination.leave.changed",
        "procurement.feed_purchase.recorded"
      ]
    },
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "schema_ref": {
      "type": "string",
      "format": "uri-reference"
    },
    "aggregate_type": {
      "type": "string",
      "enum": [
        "goat",
        "identifier",
        "identity_conflict",
        "identity_decision",
        "correction_request",
        "calendar_notification",
        "calendar_snooze",
        "obligation_escalation",
        "obligation_instance",
        "vaccination_completion",
        "protocol_version",
        "admin_ui_config_family",
        "count_base_anchor",
        "shifting_event",
        "count_projection_exception",
        "counts_approval_request",
        "pc_care_task",
        "verification_item",
        "weighing",
        "vaccination_batch",
        "park",
        "absence",
        "health_protocol_version",
        "health_diagnosis_run",
        "health_case",
        "feed_packing_completion",
        "feed_distribution_completion",
        "feed_direction_session_completion",
        "feed_purchase"
      ]
    },
    "aggregate_id": {
      "type": "string",
      "format": "uuid"
    },
    "subject_type": {
      "type": "string",
      "enum": [
        "goat",
        "identifier",
        "identity_conflict",
        "identity_decision",
        "correction_request",
        "location",
        "calendar_event",
        "obligation_instance",
        "vaccination_completion",
        "protocol_version",
        "admin_ui_config_family",
        "count_base_anchor",
        "shifting_event",
        "count_projection_exception",
        "verification_item",
        "weighing_campaign",
        "weighing_campaign_shed",
        "weighing_observation",
        "vaccination_batch",
        "notification_request",
        "health_protocol_version",
        "feed_purchase"
      ]
    },
    "subject_id": {
      "type": "string",
      "minLength": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "service",
        "module"
      ],
      "properties": {
        "service": {
          "type": "string",
          "minLength": 1
        },
        "module": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 8,
      "maxLength": 320
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actor_type"
      ],
      "properties": {
        "actor_type": {
          "type": "string",
          "enum": [
            "human",
            "system_rule",
            "import_job",
            "device",
            "ai_proposal"
          ]
        },
        "actor_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "actor_ref": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      }
    },
    "visibility_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tenant_id"
      ],
      "properties": {
        "tenant_id": {
          "type": "string",
          "format": "uuid"
        },
        "custodian_party_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "farm_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "park_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "shed_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "cohort_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        }
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence_ref"
      },
      "default": []
    },
    "payload": {
      "type": "object"
    },
    "trace_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "replay": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "is_replay"
      ],
      "properties": {
        "is_replay": {
          "type": "boolean"
        },
        "replay_of_event_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "dlq_repair_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "attempt": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      }
    }
  },
  "$defs": {
    "evidence_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_type",
        "evidence_id"
      ],
      "properties": {
        "evidence_type": {
          "type": "string",
          "enum": [
            "source_record",
            "identifier",
            "goat",
            "event",
            "media",
            "decision",
            "import_run",
            "conflict",
            "location",
            "actor",
            "notification_request",
            "obligation_status_event",
            "count_base_anchor",
            "shifting_event",
            "count_projection_exception"
          ]
        },
        "evidence_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "source_system": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 120
        },
        "description": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 500
        }
      }
    }
  }
}
