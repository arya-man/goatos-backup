{
  "schemaVersion": 1,
  "description": "Read-only admin-web module journeys that must move with dashboard features pushed to main.",
  "forbiddenActions": [
    "submit forms",
    "approve/reject/close records",
    "create/update/delete business data",
    "trigger exports with backend side effects",
    "play remote videos or unbounded media"
  ],
  "requiredModules": [
    "weighing",
    "vaccination",
    "feed",
    "sales",
    "procurement",
    "counts-herd",
    "health",
    "work-board-action-center",
    "calendar",
    "people",
    "operations"
  ],
