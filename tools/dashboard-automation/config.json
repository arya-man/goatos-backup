{
  "$schema": "./config.schema.notes",
  "productionUrl": "https://dashboard.mesha.sg",
  "desktopViewport": {
    "width": 1440,
    "height": 1000
  },
  "mobileViewport": {
    "width": 390,
    "height": 844
  },
  "requiredFailureStrings": [
    "backend_down",
    "Admin-web contract unavailable",
    "The board could not be loaded",
    "Weights could not be loaded"
  ],
  "ociAlwaysFree": {
    "required": true,
    "expectedBootVolumeGb": 100,
    "minimumFreeFilesystemGb": 20,
    "forbiddenOperations": [
      "createVolume",
      "createBootVolumeBackup",
      "resizeVolume",
      "publicLoadBalancer",
      "paidPerformanceTier"
    ]
  },
  "agentReview": {
    "enabledByDefault": true,
    "perRunBudgetUsd": 1,
    "monthlyBudgetUsd": 25,
    "passingSamplePercent": 10,
    "budgetWarningPercent": 80,
    "budgetHardStopPercent": 100
  },
  "slackAlerts": {
    "enabledByDefault": true,
    "channelId": "C0C39G90FCJ",
    "channelName": "goatos-automation-alerts",
    "minimumRepeatIntervalMinutes": 240,
    "postOn": [
      "failure",
      "auth_blocked",
      "self_healing_pr",
      "recovery"
    ]
  },
  "selfHealing": {
    "enabledByDefault": true,
    "mode": "pull_request_only",
    "reviewers": [
      "raviteja786143",
      "manohar-mesha"
    ],
    "forbiddenActions": [
      "autoMerge",
      "autoDeploy",
      "autoApprove",
      "writeProductionData",
      "writeStagingData",
      "writeOciData",
      "repairStagingData"
    ],
    "checksBeforePr": [
      "staticInventory",
      "businessDataParity",
      "vaccinationLifecycle",
      "apiLatencyPolicy",
      "productionOrPreviewSmoke",
      "agentJudgeReview"
    ]
  },
  "businessDataParity": {
    "enabledByDefault": true,
    "stgReadIdentityRequired": true,
    "stgReadOnlyTransactionRequired": true,
    "ociReadOnlyCheckRequired": true,
    "criticalTableFingerprintRequired": true,
    "fieldReconciliationsAreDatedEvidence": true,
    "criticalTables": [
      "goats",
      "goat_identifiers",
      "goat_shed_partitions",
      "locations",
      "weighing_observations",
      "weighing_shed_observations",
      "weighing_campaigns",
      "weighing_campaign_sheds",
      "procurement_loads",
      "procurement_load_goats",
      "feed_item_catalog",
      "feed_purchases",
      "feed_direction_completions",
      "sales_deals",
      "sales_deal_lines",
      "goat_sale_allocations",
      "sales_sold_animal_tags",
      "vaccination_source_facts",
      "vaccination_completions",
      "vaccination_drive_assignments",
      "vaccination_drive_assignment_members"
    ],
    "bestEffortTables": [
      "herd_signal_animals",
      "herd_signal_events",
      "herd_signal_gateways",
      "herd_signal_readings"
    ],
    "sentinelQueries": [
      {
        "name": "cbe_herd_analytics_window",
        "implementationStatus": "implemented",
        "description": "CBE live herd, kids/adults, and exits for the visible weekly Herd Analytics window."
      },
      {
        "name": "castro_reconciliation",
        "implementationStatus": "implemented",
        "description": "Castro operator evidence reconciliation, backed by dated fieldReconciliations for current/dead/ICU/sold/Y1/total counts."
      },
      {
        "name": "godel_2_timewise_adg",
        "implementationStatus": "implemented",
        "description": "No weighing campaign shed may use active shed + partition when a planner alias row exists for the same physical pen; this prevents Godel/Mandela/Castro ADG history splits."
      },
      {
        "name": "weighing_pen_alias_form_b_rows",
        "implementationStatus": "implemented",
        "description": "Detects Form B weighing rows (shed id + partition_label) when the canonical planner alias row exists (alias location_id + NULL partition_label)."
      },
      {
        "name": "sales_sold_weight_coverage",
        "implementationStatus": "implemented",
        "description": "Sold animals by weight must include deal-line average weights when animal tags lack per-animal weights."
      }
    ],
    "fieldReconciliations": [
      {
        "name": "castro_3_partition_3_2026_09_21",
        "source": "Manju WhatsApp evidence 2026-09-21 11:33 IST",
        "source_shed_name": "Castro 3",
        "partition_label": "3",
        "expected": {
          "now": 59,
          "deaths": 6,
          "icu": 3,
          "sold": 1,
          "y1": 1,
          "total": 70
        }
      }
    ]
  },
  "apiLatencyPolicy": {
    "hotPathP90Ms": 300,
    "hotPathP95Ms": 500,
    "hotPathP99Ms": 500,
    "allowLongRunningPatterns": [
      "/bulk-upload",
      "/imports",
      "/export.csv",
      "/proof-media/upload",
      "/app/proof-media/upload"
    ],
    "normalDashboardApisMustStayUnderMs": 500
  },
  "explicitRouteExclusions": [
    {
      "pattern": "/login",
      "reason": "Authentication boundary, not an authenticated admin dashboard surface."
    },
    {
      "pattern": "/api/**",
      "reason": "Backend/API route, covered by API and integration tests rather than browser route inventory."
    }
  ]
}
