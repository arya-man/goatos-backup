{
  "$schema": "./config.schema.notes",
  "productionUrl": "https://dashboard.mesha.sg",
  "desktopViewport": {
    "width": 1440,
    "height": 1000
  },
  "mobileViewport": {
    "width": 390,
    "height": 844
  },
  "requiredFailureStrings": [
    "backend_down",
    "Admin-web contract unavailable",
    "The board could not be loaded",
    "Weights could not be loaded"
  ],
  "ociAlwaysFree": {
    "required": true,
    "expectedBootVolumeGb": 100,
    "minimumFreeFilesystemGb": 20,
    "forbiddenOperations": [
      "createVolume",
      "createBootVolumeBackup",
      "resizeVolume",
      "publicLoadBalancer",
      "paidPerformanceTier"
    ]
  },
  "agentReview": {
    "enabledByDefault": false,
    "perRunBudgetUsd": 1,
    "monthlyBudgetUsd": 25,
    "passingSamplePercent": 10,
    "budgetWarningPercent": 80,
    "budgetHardStopPercent": 100
  },
  "explicitRouteExclusions": [
    {
      "pattern": "/login",
      "reason": "Authentication boundary, not an authenticated admin dashboard surface."
    },
    {
      "pattern": "/api/**",
      "reason": "Backend/API route, covered by API and integration tests rather than browser route inventory."
    }
  ]
}
