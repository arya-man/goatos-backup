{
  "lane": "write-journeys",
  "target": "the writable OCI clone, or a disposable preview database. Never production, never STG.",
  "tokenPlaceholder": "{{token}}",
  "notes": [
    "Every journey declares the tables it writes. The harness snapshots exactly those before the journey and restores them after, then proves the restore by row count and content fingerprint.",
    "generatedTables are rows the product creates as a consequence of the journey's own write (publishing a plan version generates the work it implies). They are snapshotted and restored with the rest, because leaving them behind would poison the clone. This lane never refreshes any table from STG.",
    "humanFailure is the sentence a farm manager reads in Slack. It never contains SQL, a table name, a column, a selector or a check code.",
    "simulatedWrite is the write the journey's screen makes, expressed directly. It is used only by --simulate-write, for proving the snapshot/assert/restore machinery against a real clone when no browser stack is up. A run that used it records screenDriven: false and never claims the screen was proved."
  ],
  "journeys": [
    {
      "name": "publish-vaccination-plan-version",
      "story": "A manager publishes a new vaccination plan version.",
      "route": "vaccination-plan-edit",
      "url": "/vaccination/plan/edit?scope_mode=company",
      "steps": [
        {
          "do": "open the vaccination plan editor"
        },
        {
          "do": "start a new version",
          "click": {
            "text": "New version"
          }
        },
        {
          "do": "name the version",
          "fill": {
            "label": "Version name",
            "value": "Automation check {{token}}"
          }
        },
        {
          "do": "publish it",
          "click": {
            "text": "Publish"
          },
          "confirm": true
        }
      ],
      "screenAssertion": {
        "description": "the plan editor shows the new version as published",
        "visible": [
          {
            "text": "Automation check {{token}}"
          },
          {
            "text": "Published"
          }
        ]
      },
      "dbAssertion": {
        "description": "the published version exists, is marked published, and carries at least one dose rule",
        "sql": "select v.protocol_version_id::text from protocol_versions v join protocol_rules r on r.protocol_version_id = v.protocol_version_id where v.version_label = 'Automation check {{token}}' and v.status = 'published' limit 1",
        "expect": "at-least-one-row"
      },
      "writesTables": [
        "protocol_versions",
        "protocol_rules",
        "protocol_rule_dimensions"
      ],
      "generatedTables": [
        "obligation_batches",
        "obligation_instances",
        "obligation_status_events",
        "outbox_messages"
      ],
      "humanFailure": "Publishing a new vaccination plan version did not save. A manager who publishes a plan would be told it worked and find nothing there.",
