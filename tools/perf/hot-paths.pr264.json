      "pr264_work_board_page_cpt",
      "pr264_app_vaccination_execution_with_card_summaries",
      "pr264_app_vaccination_execution_fresh_as_of"
    ],
    "included": [
      "pr264_weighing_dates",
      "pr264_weighing_shed_weights",
      "pr264_weighing_weight_demographics",
      "pr264_weighing_weight_demographics_dimensions_section",
      "pr264_weighing_weight_demographics_origin_section",
      "pr264_weighing_weight_demographics_shed_type_section",
      "pr264_weighing_weight_demographics_weight_bands_section",
      "pr264_weighing_weight_demographics_weekly_gain_section",
      "pr264_weighing_growth_weights_sections",
      "pr264_weighing_growth_general_sections",
      "pr264_weighing_growth_time_sections",
      "pr264_growth_director_weights_sections",
      "pr264_work_board_page_cbe",
      "pr264_work_board_page_cpt",
      "pr264_app_vaccination_execution_with_card_summaries",
      "pr264_app_vaccination_execution_fresh_as_of"
    ],
    "evidence_boundaries": {
      "local_oci_pr264_route_reads": [
        "pr264_weighing_dates",
        "pr264_weighing_shed_weights",
        "pr264_weighing_weight_demographics",
        "pr264_weighing_weight_demographics_dimensions_section",
        "pr264_weighing_weight_demographics_origin_section",
        "pr264_weighing_weight_demographics_shed_type_section",
        "pr264_weighing_weight_demographics_weight_bands_section",
        "pr264_weighing_weight_demographics_weekly_gain_section",
        "pr264_weighing_growth_weights_sections",
        "pr264_weighing_growth_general_sections",
        "pr264_weighing_growth_time_sections",
        "pr264_growth_director_weights_sections",
        "pr264_work_board_page_cbe",
        "pr264_work_board_page_cpt",
        "pr264_app_vaccination_execution_with_card_summaries",
        "pr264_app_vaccination_execution_fresh_as_of"
      ],
      "pr264_browser_render_routes": [
        "/procurement/animal-purchases?scope_mode=company",
        "/work-board?scope_mode=company",
        "/work-board?scope_mode=company&date=2026-08-10",
        "/weighing/weights?scope_mode=company",
        "/weighing/analytics?scope_mode=company&tab=general",
        "/weighing/analytics?scope_mode=company&tab=breed",
        "/weighing/analytics?scope_mode=company&tab=breed&wt_from=${dynamic}&wt_to=${dynamic}",
        "/weighing/analytics?scope_mode=company&tab=birth",
        "/weighing/analytics?scope_mode=company&tab=shed",
        "/weighing/analytics?scope_mode=company&tab=weight",
        "/weighing/analytics?scope_mode=company&tab=time",
        "/weighing/analytics?scope_mode=company&tab=load"
      ]
    },
    "excluded": {
      "browser_render": "Required as separate PR264 browser evidence against the same API build; it must fail on backend_down, Admin-web contract unavailable, The board could not be loaded, and Weights could not be loaded.",
      "work_board_legacy_fanout": "Before/after comparison must run the old /work-board/summary + /work-board/rows fanout on the baseline checkout; this manifest certifies the after bundled endpoint.",
      "vaccination_card_summary_shortcut": "Android currently needs page-independent card summaries for truthful cross-page card status, so this manifest measures the expensive truthful path instead of hiding it."
    }
  },
  "endpoints": [
    {
      "name": "pr264_weighing_dates",
      "method": "GET",
      "path": "/weighing/weighing-dates?from={weighing_lookback_from}&to={weighing_today}&sex=male",
      "max_response_bytes": 262144,
      "assertion": { "type": "array_min", "path": "lump_weighing_dates", "min": 1 }
    },
    {
      "name": "pr264_weighing_shed_weights",
      "method": "GET",
      "path": "/weighing/shed-weights?from={weighing_from}&to={weighing_to}&sex=male",
      "max_response_bytes": 524288,
      "assertion": { "type": "array_min", "path": "rows", "min": 1 }
    },
    {
      "name": "pr264_weighing_weight_demographics",
      "method": "GET",
      "path": "/weighing/weight-demographics?from={weighing_from}&to={weighing_to}&sex=male&sections=composition,dimensions,gain_thresholds",
      "max_response_bytes": 262144,
      "assertion": { "type": "array_min", "path": "by_breed", "min": 1 }
    },
    {
      "name": "pr264_weighing_weight_demographics_dimensions_section",
      "method": "GET",
      "path": "/weighing/weight-demographics?from={weighing_from}&to={weighing_to}&sex=male&sections=dimensions",
      "max_response_bytes": 262144,
      "assertion": { "type": "array_min", "path": "by_breed", "min": 1 }
    },
    {
      "name": "pr264_weighing_weight_demographics_origin_section",
      "method": "GET",
      "path": "/weighing/weight-demographics?from={weighing_from}&to={weighing_to}&sex=male&sections=origin",
      "max_response_bytes": 262144,
      "assertion": { "type": "array_min", "path": "gain_by_breed_origin", "min": 1 }
    },
    {
      "name": "pr264_weighing_weight_demographics_shed_type_section",
      "method": "GET",
      "path": "/weighing/weight-demographics?from={weighing_from}&to={weighing_to}&sex=male&sections=shed_type",
      "max_response_bytes": 262144,
      "assertion": { "type": "array_min", "path": "gain_by_breed_shed_type", "min": 1 }
    },
    {
      "name": "pr264_weighing_weight_demographics_weight_bands_section",
      "method": "GET",
      "path": "/weighing/weight-demographics?from={weighing_from}&to={weighing_to}&sex=male&sections=weight_bands",
      "max_response_bytes": 262144,
      "assertion": { "type": "array_min", "path": "by_weight_band", "min": 1 }
    },
    {
      "name": "pr264_weighing_weight_demographics_weekly_gain_section",
      "method": "GET",
      "path": "/weighing/weight-demographics?from={weighing_from}&to={weighing_to}&sex=male&sections=weekly_gain",
      "max_response_bytes": 262144,
      "assertion": { "type": "array_min", "path": "gain_by_breed_week", "min": 1 }
    },
    {
      "name": "pr264_weighing_growth_weights_sections",
      "method": "GET",
      "path": "/weighing/leadership/growth?from={weighing_from}&to={weighing_to}&sex=male&sections=headline,shed_leaderboard,losing_animals",
      "max_response_bytes": 262144,
      "assertion": { "type": "number_min", "path": "headline.headline_animals", "min": 0 }
    },
    {
      "name": "pr264_weighing_growth_general_sections",
      "method": "GET",
      "path": "/weighing/leadership/growth?from={weighing_from}&to={weighing_to}&sex=male&sections=headline,shed_leaderboard,by_park",
      "max_response_bytes": 262144,
      "assertion": { "type": "array_min", "path": "by_park", "min": 1 }
    },
    {
      "name": "pr264_weighing_growth_time_sections",
      "method": "GET",
      "path": "/weighing/leadership/growth?from={weighing_from}&to={weighing_to}&sex=male&sections=weekly_gain",
      "max_response_bytes": 262144,
      "assertion": { "type": "array_min", "path": "weekly_gain", "min": 1 }
    },
    {
      "name": "pr264_growth_director_weights_sections",
      "method": "GET",
      "path": "/growth-director/weights?from={weighing_from}&to={weighing_to}&sex=male&sections=road_to_sale,fair_fight",
      "max_response_bytes": 524288,
      "assertion": { "type": "number_min", "path": "road_to_sale.total_animals", "min": 0 }
    },
    {
      "name": "pr264_work_board_page_cbe",
      "method": "GET",
      "path": "/work-board/page?park=00000000-0000-4000-8000-000000003001&business_date=2026-08-10&limit=50",
      "max_response_bytes": 1048576,
      "assertion": { "type": "array_min", "path": "lanes.todo.rows", "min": 1 }
    },
    {
      "name": "pr264_work_board_page_cpt",
      "method": "GET",
      "path": "/work-board/page?park=00000000-0000-4000-8000-000000003002&business_date=2026-08-10&limit=50",
      "max_response_bytes": 1048576,
      "assertion": { "type": "array_min", "path": "lanes.todo.rows", "min": 1 }
    },
    {
      "name": "pr264_app_vaccination_execution_with_card_summaries",
      "method": "GET",
      "path": "/app/vaccination/execution?limit=20&include_filter_options=true&include_card_summaries=true",
      "max_response_bytes": 1048576,
      "assertion": { "type": "array_min", "path": "rows", "min": 1 }
    },
    {
      "name": "pr264_app_vaccination_execution_fresh_as_of",
      "method": "GET",
      "path": "/app/vaccination/execution?limit=20&include_filter_options=true&include_card_summaries=true",
      "request_strategy": "fresh_as_of",
      "max_response_bytes": 1048576,
      "assertion": { "type": "array_min", "path": "rows", "min": 1 }
    }
  ]
}
