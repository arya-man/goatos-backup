{
  "scope": {
    "included": [
      "control_tower",
      "action_center",
      "action_center_counts",
      "protocol_adherence",
      "calendar_vaccination",
      "calendar_vaccination_completed_history",
      "calendar_vaccination_date_markers",
      "vaccination_schedule",
      "vaccination_execution",
      "vaccination_operations",
      "vaccination_shed_summary"
    ],
    "evidence_boundaries": {
      "canonical_5k_50k_serving_reads": [
        "control_tower",
        "action_center",
        "action_center_counts",
        "protocol_adherence",
        "calendar_vaccination",
        "vaccination_schedule",
        "vaccination_shed_summary"
      ],
      "local_nonempty_latency_only": [
        "calendar_vaccination_completed_history",
        "calendar_vaccination_date_markers",
        "vaccination_execution",
        "vaccination_operations"
      ]
    },
    "excluded": {
      "admin_web_bootstrap": "Owned by the bootstrap cache/ETag gate; not hidden inside this command-lens result.",
      "sop_library_and_detail": "Owned by the SOP prefix-search/detail request-plan gate.",
      "workflow_and_row_detail": "Detail paths require selected backend-issued identities and a separate drilldown contract.",
      "animal_lists": "Per-shed animal pages are keyset-paged and require a selected shed; they are not a tenant-wide list.",
      "full_chain_bulk_writes": "This is canonical serving-read evidence for the 5k-50k envelope, not a bulk command-write certification.",
      "async_architecture": "Pub/Sub delivery, DLQ recovery, idempotency concurrency, and consumer backpressure require separate architecture/load gates."
    }
  },
  "endpoints": [
    {
      "name": "control_tower",
      "method": "GET",
      "path": "/control-tower/vaccination?category=vaccination",
      "p90_ms": 300,
      "p95_ms": 500,
      "p99_ms": 500,
      "max_response_bytes": 524288,
      "assertion": { "type": "array_min", "path": "alerts", "min": 1 }
    },
    {
      "name": "action_center",
      "method": "GET",
      "path": "/vaccination/action-center?category=vaccination&limit=50",
      "p90_ms": 300,
      "p95_ms": 500,
      "p99_ms": 500,
      "max_response_bytes": 524288,
      "assertion": { "type": "array_min", "path": "items", "min": 1 }
    },
    {
      "name": "action_center_counts",
      "method": "GET",
      "path": "/vaccination/action-center/counts?category=vaccination",
      "p90_ms": 250,
      "p95_ms": 500,
      "p99_ms": 500,
      "max_response_bytes": 65536,
      "assertion": { "type": "number_min", "path": "total_count", "min": 1 }
    },
    {
      "name": "protocol_adherence",
      "method": "GET",
      "path": "/vaccination/adherence?category=vaccination&limit=50",
      "p90_ms": 300,
      "p95_ms": 500,
      "p99_ms": 500,
      "max_response_bytes": 524288,
      "assertion": { "type": "array_min", "path": "rows", "min": 1 }
    },
    {
      "name": "calendar_vaccination",
      "method": "GET",
      "path": "/calendar/vaccination/events?date_from={today}&date_to={today_plus_7}&limit=50",
      "p90_ms": 300,
      "p95_ms": 500,
      "p99_ms": 500,
      "max_response_bytes": 524288,
      "assertion": { "type": "array_min", "path": "items", "min": 1 }
    },
    {
      "name": "calendar_vaccination_completed_history",
      "method": "GET",
      "path": "/calendar/vaccination/events?date_from={today_minus_30}&date_to={today_plus_1}&status=completed&limit=50",
      "p90_ms": 300,
      "p95_ms": 500,
      "p99_ms": 500,
      "max_response_bytes": 524288,
      "assertion": { "type": "array_min", "path": "items", "min": 1 }
    },
    {
      "name": "calendar_vaccination_date_markers",
      "method": "GET",
      "path": "/calendar/vaccination/events?date_from={today}&date_to={today_plus_30}&include_date_markers=true&markers_only=true&limit=1",
      "p90_ms": 300,
      "p95_ms": 500,
      "p99_ms": 500,
      "max_response_bytes": 524288,
      "assertion": { "type": "array_min", "path": "date_markers", "min": 1 }
    },
    {
      "name": "vaccination_schedule",
      "method": "GET",
      "path": "/vaccination/schedule?limit=50",
      "p90_ms": 300,
      "p95_ms": 500,
      "p99_ms": 500,
      "max_response_bytes": 524288,
      "assertion": { "type": "array_min", "path": "cohorts", "min": 1 }
    },
    {
      "name": "vaccination_execution",
      "method": "GET",
      "path": "/vaccination/execution?limit=50",
      "p90_ms": 300,
      "p95_ms": 500,
      "p99_ms": 500,
      "max_response_bytes": 524288,
      "assertion": { "type": "array_min", "path": "rows", "min": 1 }
    },
    {
      "name": "vaccination_operations",
      "method": "GET",
      "path": "/vaccination/operations?limit=50",
      "p90_ms": 300,
      "p95_ms": 500,
      "p99_ms": 500,
      "max_response_bytes": 524288,
      "assertion": { "type": "array_min", "path": "cohorts", "min": 1 }
    },
    {
      "name": "vaccination_shed_summary",
      "method": "GET",
      "path": "/vaccination/sheds?limit=50",
      "p90_ms": 300,
      "p95_ms": 500,
      "p99_ms": 500,
      "max_response_bytes": 524288,
      "assertion": { "type": "array_min", "path": "rows", "min": 1 }
    }
  ]
}
