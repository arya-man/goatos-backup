    "excluded": {
      "lighthouse_and_pagespeed": "Owned by apps/admin-web/scripts/capture-lighthouse.mjs and apps/admin-web/scripts/capture-pagespeed.mjs; those capture browser lab scores, not authenticated API hot-path p95.",
      "calendar_cold_canonical_read": "Calendar canonical first-read SQL still has a cold path outside the cache-safe analytics fix; this manifest keeps the route-switch warm percentile guarded while the deeper SQL rewrite is handled separately.",
