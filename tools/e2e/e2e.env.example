# E2E database configuration — template.
#
# Copy to tools/e2e/e2e.env (gitignored), fill in for your own machine, and source it:
#
#   cp tools/e2e/e2e.env.example tools/e2e/e2e.env
#   $EDITOR tools/e2e/e2e.env
#   source tools/e2e/e2e.env
#
# Nothing host-specific belongs in the repo: addresses, key paths and credentials
# are personal infrastructure. This file exists so the shape is documented and the
# real values stay local.
#
# The database this points at MUST be disposable. These scripts drop and recreate
# databases. Never point them at Cloud SQL or at anything you cannot lose.

# Where Postgres is reachable. Typically a locally forwarded port, e.g. an SSH
# tunnel to a dev VM:
#   ssh -N -L <local-port>:127.0.0.1:5432 <user>@<host>   # then set E2E_PG_PORT to it
export E2E_PG_HOST=127.0.0.1
export E2E_PG_PORT=5432
export E2E_PG_USER=postgres
export E2E_PG_PASSWORD=

# The restored staging clone that the template is built from. Read-only as far as
# the tests are concerned — cases always run against a throwaway copy.
export E2E_SOURCE_DB=goatos

# The frozen template each case is cloned from.
export E2E_TEMPLATE_DB=goatos_base

# Test databases must match ^goatos_e2e[a-z0-9_]*$ — the reset command refuses
# anything else, so a typo cannot drop a real database.
