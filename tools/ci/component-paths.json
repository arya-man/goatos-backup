{
  "version": 1,
  "forceFull": {
    "prefixes": [
      ".github/workflows/",
      ".github/actions/",
      "tools/agent-hooks/"
    ],
    "exceptFiles": [
      "tools/agent-hooks/postgres-bind-contract-baseline.json"
    ],
    "files": [
      "Makefile",
      "package.json",
      "package-lock.json",
      "go.work",
      "go.work.sum"
    ]
  },
  "ciCommonOnly": {
    "files": [
      "tools/ci/android-ui-diff.sh",
      "tools/ci/android-screenshot-scope.sh",
      "tools/ci/check-android-screenshot-proof.sh",
      "tools/ci/check-android-screenshot-proof.test.sh",
      "tools/ci/check-android-screenshot-scope.test.sh",
      "tools/ci/check-android-ui-diff.test.sh",
      "tools/ci/check-local-ci-evidence.mjs",
      "tools/ci/check-run-local-ci-parallel.test.sh",
      "tools/ci/check-screenshot-remediation.sh",
      "tools/ci/check-screenshot-remediation.test.sh",
      "tools/ci/ci-scope.mjs",
      "tools/ci/component-paths.json",
      "tools/ci/land-main.sh",
      "tools/ci/land-main.test.sh",
      "tools/ci/land-route.sh",
      "tools/ci/land-route.test.sh",
      "tools/ci/run-local-ci.sh",
      "tools/agent-hooks/install-stg-push-guard.sh"
    ]
  },
  "docsOnly": {
    "prefixes": [
      "docs/"
    ],
    "files": [
      "AGENTS.md",
      "CLAUDE.md",
      "CODEX.md",
      "SKILLS.md"
    ]
  },
  "queryPlans": {
    "sqlc": {
      "_why": "validate-sqlc-query-plans.sh EXPLAINs its own inline SQL against a DB built only from backend/migrations/postgres; its verdict is a pure function of these inputs. Any .sql (sqlc query/schema) edit also schedules it.",
      "files": [
        "backend/tests/integration/validate-sqlc-query-plans.sh",
        "tools/postgres-ci.sh"
      ],
      "prefixes": [
        "backend/migrations/"
      ],
      "extensions": [
        ".sql"
      ]
    },
    "commandboard": {
      "_why": "commandboard-query-plan-guard.sh runs go test on vaccinationexecution/adapters/postgres over a migrated DB. `dirs` (exact package dirs, not subtrees) = that test's `go list -test -deps` internal closure outside vaccinationexecution; `make commandboard-query-plan-wiring-guard` fails if it drifts.",
      "files": [
        "tools/dev/commandboard-query-plan-guard.sh",
        "backend/go.mod",
        "backend/go.sum"
      ],
      "prefixes": [
        "backend/migrations/",
        "backend/internal/vaccinationexecution/"
      ],
      "dirs": [
        "backend/internal/outbox/adapters/postgres/",
        "backend/internal/outbox/adapters/publisher/eventbus/",
        "backend/internal/outbox/app/",
        "backend/internal/outbox/domain/",
        "backend/internal/outbox/ports/",
        "backend/internal/permissions/",
        "backend/internal/platform/audit/",
        "backend/internal/platform/auth/",
        "backend/internal/platform/authallow/",
        "backend/internal/platform/biztime/",
        "backend/internal/platform/eventbus/",
        "backend/internal/platform/httpmiddleware/",
        "backend/internal/platform/kmetrics/",
        "backend/internal/platform/localization/",
        "backend/internal/platform/oploc/",
        "backend/internal/platform/outbox/",
        "backend/internal/platform/pgtest/",
        "backend/internal/platform/readcache/",
        "backend/internal/platform/sqlbind/",
        "backend/internal/platform/tracecontext/",
        "backend/internal/platform/uuidutil/",
        "backend/internal/vaccination/domain/",
        "backend/internal/verification/samplingsql/"
      ]
    }
  },
  "fanout": [
    {
      "name": "shared-api-contracts",
      "prefixes": [
        "contracts/",
        "packages/api-client/"
      ],
      "components": [
        "backend",
        "adminWeb"
      ]
    },
    {
      "name": "verification-proof-media-surface",
      "prefixes": [
        "backend/internal/verification/",
        "apps/admin-web/features/verification-review/",
        "apps/goatos-android/feature/feature-verify/",
        "apps/goatos-android/app/src/main/kotlin/sg/mesha/goatos/viewmodel/VerifyQueueViewModel.kt",
        "apps/goatos-android/core/core-network/src/main/kotlin/sg/mesha/goatos/core/network/dto/VerificationDto.kt"
      ],
      "components": [
        "backend",
        "adminWeb",
        "android"
      ]
    }
  ],
  "components": {
    "backend": {
      "prefixes": [
        "backend/",
        "deploy/",
        "infra/",
        "load-tests/",
        "tools/perf/",
        "tools/scale-guard/"
      ],
      "files": [
        "tools/agent-hooks/postgres-bind-contract-baseline.json",
        "tools/dev/commandboard-query-plan-guard.sh"
      ]
    },
    "adminWeb": {
      "prefixes": [
        "apps/admin-web/",
        "backend/internal/adminui/app/",
        "mock/"
      ],
      "files": []
    },
    "android": {
      "prefixes": [
        "apps/goatos-android/",
        "tools/android/"
      ],
      "files": []
    }
  },
  "commonOnly": {
    "prefixes": [
      ".agents/",
      ".claude/",
      ".codex/",
      "context/",
      "docs/",
      "fixtures/",
      "tools/deploy/",
      "tools/ask-mesha-agent/"
    ],
    "files": [
      "cloudbuild.stg.yaml",
      ".gitignore",
      "AGENTS.md",
      "CLAUDE.md",
      "CODEX.md",
      "README.md",
      "SKILLS.md"
    ],
    "extensions": [
      ".md",
      ".example"
    ]
  }
}
