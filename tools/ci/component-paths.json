{
  "version": 1,
  "forceFull": {
    "prefixes": [
      ".github/workflows/",
      ".github/actions/",
      "tools/agent-hooks/"
    ],
    "files": [
      "Makefile",
      "package.json",
      "package-lock.json",
      "go.work",
      "go.work.sum"
    ]
  },
  "ciCommonOnly": {
    "files": [
      "tools/ci/android-ui-diff.sh",
      "tools/ci/check-android-ui-diff.test.sh",
      "tools/ci/check-local-ci-evidence.mjs",
      "tools/ci/check-screenshot-remediation.sh",
      "tools/ci/ci-scope.mjs",
      "tools/ci/component-paths.json",
      "tools/ci/land-main.sh",
      "tools/ci/land-main.test.sh",
      "tools/ci/run-local-ci.sh",
      "tools/agent-hooks/install-stg-push-guard.sh"
    ]
  },
  "queryPlans": {
    "prefixes": [
      "backend/migrations/",
      "backend/internal/analytics/adapters/postgres/",
      "backend/internal/calendar/adapters/postgres/",
      "backend/internal/feed/adapters/postgres/",
      "backend/internal/feeddirection/adapters/postgres/",
      "backend/internal/obligation/adapters/postgres/",
      "backend/internal/permissions/adapters/postgres/",
      "backend/internal/platform/postgres/",
      "backend/internal/scale/adapters/postgres/",
      "backend/internal/vaccination/adapters/postgres/",
      "backend/internal/weighing/adapters/postgres/"
    ],
    "extensions": [
      ".sql"
    ]
  },
  "fanout": [
    {
      "name": "shared-api-contracts",
      "prefixes": [
        "contracts/",
        "packages/api-client/"
      ],
      "components": [
        "backend",
        "adminWeb",
        "android"
      ]
    }
  ],
  "components": {
    "backend": {
      "prefixes": [
        "backend/",
        "deploy/",
        "infra/",
        "load-tests/",
        "tools/perf/",
        "tools/scale-guard/"
      ],
      "files": []
    },
    "adminWeb": {
      "prefixes": [
        "apps/admin-web/",
        "mock/"
      ],
      "files": []
    },
    "android": {
      "prefixes": [
        "apps/goatos-android/",
        "tools/android/"
      ],
      "files": []
    }
  },
  "commonOnly": {
    "prefixes": [
      ".agents/",
      ".claude/",
      ".codex/",
      "context/",
      "docs/",
      "fixtures/"
    ],
    "files": [
      ".gitignore",
      "AGENTS.md",
      "CLAUDE.md",
      "CODEX.md",
      "README.md",
      "SKILLS.md"
    ],
    "extensions": [
      ".md"
    ]
  }
}
