      "makeTarget": "git-identity-guard",
      "realCheck": "node tools/ci/check-git-identity.mjs",
      "selfTest": "node tools/ci/check-git-identity.mjs --self-test",
      "owningDoc": "AGENTS.md",
      "requiredInCI": true,
      "ciStep": "git-identity-guard"
    },
    {
      "id": "guardrail-registration",
