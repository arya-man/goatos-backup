      "owningDoc": "docs/runbooks/local-release-evidence.md",
      "requiredInCI": true,
      "ciStep": "local-ci-evidence-guard"
    },
    {
      "id": "backend-foundations",
      "script": "tools/agent-hooks/check-backend-foundations.mjs",
