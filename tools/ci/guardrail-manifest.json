{
  "$schema": "./guardrail-manifest.schema.notes",
  "description": "Single source of truth for every machine guardrail. check-guardrail-registration.mjs enforces that this manifest stays in sync with the guard scripts on disk, the Makefile `guardrails:` target, and tools/ci/run-local-ci.sh. Each entry declares: the Make target, the real-check command, the adversarial self-test command (or an explicit exemption reason), the owning documentation, and whether the guard is required by full local CI (tools/ci/run-local-ci.sh run_guardrails).",
  "conventions": {
    "requiredInCI": "true => the guard's ciStep MUST appear in tools/ci/run-local-ci.sh AND (when makeTarget is set) the makeTarget MUST appear in the Makefile `guardrails:` target body.",
    "selfTest": "Every guard MUST declare a selfTest command OR a selfTestExemptReason. A guard with neither fails registration.",
    "autoEnumerationScope": "check-guardrail-registration.mjs enumerates every check-*.mjs under tools/agent-hooks/ and tools/ci/ and fails if any is absent from `guards[].script`. Shell/Go/Python guards are listed for CI-wiring checks but are not part of the orphan scan."
  },
  "guards": [
    {
