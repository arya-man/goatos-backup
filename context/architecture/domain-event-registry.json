    {
      "contract": "shifting_completion_to_vaccination",
      "status": "prospective_until_activation_path_exists",
      "activationPaths": [
        "backend/internal/identity/adapters/postgres/goat_relocate.go"
      ],
      "producerFiles": [
        "backend/internal/identity/adapters/postgres/goat_relocate.go"
