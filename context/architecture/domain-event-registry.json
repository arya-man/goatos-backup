        {
          "module": "counts",
          "file": "backend/internal/counts/app/shifting_verification_handler.go",
          "notes": "ShiftingVerificationHandler.HandleEvent filters source.module=counts + source.ref_type=shifting_event and calls Repository.BounceShiftingEventForRework, which sets verification_state='rejected' and clears the proof-submit idempotency pair so the evidence rework appears in Actions. It preserves event_status, goat location, and census truth even when the move is already applied."
        },
        {
          "module": "feeddirection",
          "file": "backend/internal/feeddirection/app/feed_distribution_verification_handler.go",
          "notes": "FeedDistributionVerificationHandler.HandleEvent filters source.module=feed + source.ref_type=feed_distribution_completion and calls DistributionCompletionStore.BounceDistributionForRework, which returns the feed_distribution_completions row 'pending_verification' -> 'rework' (nothing completed) so the operator re-records the video + water proof and re-submits."
        },
        {
          "module": "tasks",
          "file": "backend/internal/tasks/app/event_handlers.go",
          "notes": "DeathVerificationHandler filters source.module=counts + ref_type=workflow_death_signoff and resets both death videos. BirthVerificationHandler filters ref_type=workflow_birth_signoff and calls BounceBirthVideoForRework at workflow_id grain, reopening only that mother or child's video tasks while preserving permanent RFID and count decisions."
        }
      ],
