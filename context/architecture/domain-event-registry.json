          "file": "backend/internal/obligation/app/shift.go"
        },
        {
          "eventType": "goat.stage_changed",
          "module": "vaccination",
          "file": "backend/internal/vaccination/app/generation_handler.go"
        }
      ],
      "authoritativeProfile": {
        "source": "active destination shed_profiles row joined through animal_stage_lookup",
        "snapshotAtAuthorization": [
          "destination_profile_id",
          "destination_profile_row_version"
        ],
        "evidenceFiles": [
          "backend/internal/identity/adapters/postgres/goat_relocate.go"
        ],
        "requiredTokens": [
          "shed_profiles",
          "animal_stage_lookup",
          "row_version",
          "destination_profile_id",
          "destination_profile_row_version"
        ],
        "forbiddenPatterns": [
          {
            "pattern": "SELECT\\s+DISTINCT\\s+management_stage\\s+FROM\\s+goats",
            "reason": "resident goats are observations, not destination shed configuration authority"
          }
        ]
      },
      "transactionEvidence": {
        "rule": "verified completion updates goat shed and operational stage and writes identity audit plus both outbox events in one transaction",
        "evidenceFiles": [
          "backend/internal/identity/adapters/postgres/goat_relocate.go"
        ],
