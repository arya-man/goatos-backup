{
  "stg_deploy": {
    "github_actions_enabled": false,
    "pr_driven_deploy": false,
    "manual_cloud_deploy": true,
    "deploy_authority": "google-cloud-deploy",
    "runbook": "docs/runbooks/stg-deploy.md",
    "full_mechanics_runbook": "docs/runbooks/cloud-deploy-staging.md",
    "org_boundary_runbook": "docs/runbooks/google-cloud-environments.md",
    "scripts_glob": "tools/deploy/stg-clouddeploy-*.sh",
    "source_ref": "origin/main",
    "requires_clean_worktree": true,
    "required_account": "ravi@mesha.sg",
    "required_org": "vgoats.com",
    "required_project": "goatos-stg",
    "forbidden_identities": ["slice", "heva"],
    "forbidden_projects": ["hevaplatform", "goatos-sheets", "system-gsuite", "apps-script"],
    "ci_validation": "make ci-local",
    "bug_041_blocks_deploy": false
  },
  "stg_seed_closeout": {
    "query_timeout_env": "GOATOS_PG_QUERY_TIMEOUT",
    "recommended_query_timeout": "60s",
    "runtime_defaults": { "api": "15s", "worker": "30s" },
    "scope": "seed_closeout_only",
    "do_not_change_api_runtime_defaults": true,
    "runbooks": [
      "docs/runbooks/stg-deploy.md",
      "docs/runbooks/staging-vaccination-clean-slate.md",
      "docs/runbooks/staging-vaccination-seed-preflight.md"
    ]
  },
  "stg_gcs_video_upload": {
    "runbook": "docs/runbooks/stg-gcs-video-upload-wiring.md",
    "required_for_android_video_proof": true,
    "bucket_env": "GOATOS_GCS_BUCKET",
    "forbidden_projects": ["prod", "dev", "heva", "slice"],
    "verdicts": ["PASS", "FAIL", "PARTIAL", "NOT_WIRED"]
  }
}
