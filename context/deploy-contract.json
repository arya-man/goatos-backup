{
  "stg_deploy": {
    "github_actions_enabled": false,
    "pr_driven_deploy": false,
    "manual_cloud_deploy": false,
    "deploy_authority": "slack-cloud-build-cloud-deploy",
    "slack_channel": "#goatos-stg-deploy",
    "cloud_build_trigger": "goatos-stg-deploy-main",
    "cloud_build_config": "cloudbuild.stg.yaml",
    "slack_bot_service": "goatos-stg-slack-deploy-bot",
    "runbook": "docs/runbooks/stg-deploy.md",
    "full_mechanics_runbook": "docs/runbooks/cloud-deploy-staging.md",
    "org_boundary_runbook": "docs/runbooks/google-cloud-environments.md",
    "scripts_glob": "tools/deploy/stg-clouddeploy-*.sh",
    "scripts_usage": "break_glass_or_repair_only",
    "source_ref": "origin/main",
    "requires_clean_worktree": true,
    "required_account": "ravi@mesha.sg",
    "required_org": "vgoats.com",
    "required_project": "goatos-stg",
    "forbidden_identities": ["slice", "heva"],
    "forbidden_projects": ["hevaplatform", "goatos-sheets", "system-gsuite", "apps-script"],
    "ci_validation": "make ci-local",
    "status_source_order": ["slack_posted_cloud_build", "cloud_deploy_rollout", "cloud_run_live_images"],
    "mobile_distribution_checkbox": {
      "slack_label": "Also distribute Android mobile",
      "starts_after_stg_deploy_success": true,
      "all_or_nothing_channels": [
        "Firebase App Distribution",
        "Google Play Internal Testing",
        "https://mesha.sg/app.apk"
      ],
      "play_package": "sg.mesha.goatos",
      "firebase_gradle_task": ":app:appDistributionUploadProdRelease",
      "apk_mirror": "gs://goatos-stg-public-downloads/operator/latest/app.apk"
    },
    "bug_041_blocks_deploy": false
  },
  "stg_seed_closeout": {
    "query_timeout_env": "GOATOS_PG_QUERY_TIMEOUT",
    "recommended_query_timeout": "60s",
    "runtime_defaults": { "api": "15s", "worker": "30s" },
    "scope": "seed_closeout_only",
    "do_not_change_api_runtime_defaults": true,
    "runbooks": [
      "docs/runbooks/stg-deploy.md",
      "docs/runbooks/staging-vaccination-clean-slate.md",
      "docs/runbooks/staging-vaccination-seed-preflight.md"
    ]
  },
  "stg_personnel_seed": {
    "canonical_runbook": "docs/runbooks/stg-login-seed-contract.md",
    "total_people": 9,
    "field_email_password_users": {
      "operators": ["Amit Kumar", "Darshan Talwar", "Sagar Mahoor"],
      "director": "Chandrakant"
    },
    "password_convention": "<FirstName>@2026",
    "field_passwords": {
      "Amit Kumar": "Amit@2026",
      "Darshan Talwar": "Darshan@2026",
      "Sagar Mahoor": "Sagar@2026",
      "Chandrakant": "Chandra@2026"
    },
    "default_vaccination_operator": "Darshan Talwar",
    "fallback_vaccination_operator": "Sagar Mahoor",
    "vaccination_capacity_users": ["Amit Kumar", "Darshan Talwar", "Sagar Mahoor"],
    "non_capacity_users": ["Chandrakant"],
    "leadership_sso_count": 5,
    "leadership_role": "ceo_internal",
    "leadership_auth": "google_sso_only",
    "leadership_adds_vaccination_capacity": false,
    "firebase_allowlist_is_not_enough": true,
    "firebase_user_existing_is_not_enough": true,
    "backend_grant_required": true,
    "bootstrap_must_pass": true,
    "seed_fail_condition": "FAIL unless Amit, Darshan, and Sagar appear as HRMS/vaccination operators with capacity, Chandrakant appears as director, and the 5 Mesha leadership users are SSO-only ceo_internal"
  },
  "stg_vaccination_seed_closeout": {
    "headline": "STG vaccination seed is complete only when the closeout gate passes, not when commands finish.",
    "canonical_runbook": "docs/runbooks/staging-vaccination-clean-slate.md",
    "runbook_section": "STG Vaccination Seed Closeout Contract",
    "validate_from_db_not_logs": true,
    "full_reseed_not_partial_patch": true,
    "integrity_checks_must_be_zero": [
      "unbound_obligations",
      "wrong_vaccine_memberships",
      "duplicate_memberships",
      "animal_count_not_equal_distinct_member_goats",
      "cap_over_200_per_operator_per_day",
      "null_operator_drive_rows",
      "partition_mismatch",
      "goats_bound_to_wrong_target_or_assignment"
    ],
    "lifecycle_checks": [
      "new_goat_added",
      "goat_death_exit",
      "goat_moved_between_sheds",
      "goat_moved_between_partitions_same_shed",
      "missed_cancel_reap_cleanup",
      "date_override_postponed_drive",
      "operator_capacity_changes"
    ],
    "read_surfaces_via_exact_membership": ["calendar", "control_tower", "action_center", "workflows", "protocol_adherence", "vaccination_l1_l2_l3"],
    "expected_schedule_gate": {
      "fixture": "fixtures/vaccination-cpt-operator-drive-2026-07-23/expected-drive-schedules.json",
      "ppr_absent_on": ["2026-07-24", "2026-07-25"],
      "ppr_after_et_tt_anchor": "et_tt_actual_drive_or_completion_date",
      "matrix_allowed_same_day_combos_preserved": true
    },
    "failure_blocks_stg_promotion": true,
    "failure_logged_in": "review_bugs_ledgers.md",
    "proof_artifacts": ["commit_sha", "seed_command_and_env", "expected_drive_schedule_result", "integrity_sql_output", "adult_goat_count_and_shed_totals", "pass_fail_timestamp"]
  },
  "cpt_ppr_deferral_scope": {
    "headline": "PPR deferral to 2026-08-07 is a CPT initial validation override, not a permanent no-combo rule.",
    "is_global_vaccine_scheduling_rule": false,
    "canonical_fixture": "fixtures/vaccination-cpt-operator-drive-2026-07-23/expected-drive-schedules.json",
    "initial_cpt_stg_validation_drive_only": {
      "first_drive_starts": "2026-07-24",
      "et_tt_only_dates": ["2026-07-24", "2026-07-25"],
      "ppr_moved_to_dates": ["2026-08-07", "2026-08-08"],
      "reason": "prove the first operator drive with one vaccine lane before adding PPR"
    },
    "future_real_scheduling": {
      "et_tt_and_ppr_may_be_paired_same_date_if_active_rule_says_so": true,
      "same_day_multi_vaccine_scheduling_allowed": true,
      "paired_capacity_counts_distinct_goats_not_doses": true
    }
  },
  "stg_gcs_video_upload": {
    "runbook": "docs/runbooks/stg-gcs-video-upload-wiring.md",
    "required_for_android_video_proof": true,
    "bucket_env": "GOATOS_GCS_BUCKET",
    "forbidden_projects": ["prod", "dev", "heva", "slice"],
    "verdicts": ["PASS", "FAIL", "PARTIAL", "NOT_WIRED"]
  }
}
