{
  "code": "procurement.animal_purchase",
  "status": "published",
  "version": 7,
  "form_dsl": {
    "rules": [],
    "title": "Animal Purchase Inspection",
    "fields": [
      {
        "key": "vendor",
        "type": "text",
        "label": "Vendor",
        "required": true,
        "description": "From the vendor register; lives on the load, not on the animal."
      },
      {
        "key": "farm",
        "type": "select",
        "label": "Farm",
        "options": [
          "CBE",
          "CPT"
        ],
        "required": true
      },
      {
        "key": "load_ref",
        "type": "text",
        "label": "Load number",
        "required": true
      },
      {
        "key": "expected_count",
        "min": 0,
        "type": "number",
        "label": "Roughly how many animals",
        "required": false
      },
      {
        "key": "notes",
        "type": "text",
        "label": "Note",
        "required": false
      },
      {
        "key": "animal_video",
        "type": "video_proof",
        "label": "Animal video",
        "required": true,
        "description": "Captured per animal inside the inspection pages below.",
        "proof_action": "video.capture"
      },
      {
        "key": "animal_photo",
        "type": "photo_proof",
        "label": "Animal photo",
        "required": true,
        "description": "Captured per animal inside the inspection pages below.",
        "proof_action": "photo.capture"
      }
    ],
    "sop_code": "procurement.animal_purchase",
    "inspection": {
      "pages": [
        {
          "key": "identity",
          "questions": [
            {
              "id": "species",
              "kind": "choice",
              "title": "Goat or sheep",
              "options": [
                {
                  "label": "Goat",
                  "value": "goat"
                },
                {
                  "label": "Sheep",
                  "value": "sheep"
                }
              ],
              "required": true
            },
            {
              "id": "goat_id",
              "hint": "The tag or number the vendor uses for this animal.",
              "kind": "text",
              "title": "Goat ID",
              "required": true
            },
            {
              "id": "well_fed",
              "hint": "REJECT if the animal is visibly empty or walking weakly. Yes if well fed, No if ribs are visible.",
              "kind": "choice",
              "title": "Is the animal well fed and walking actively?",
              "options": [
                {
                  "label": "Yes",
                  "value": "yes"
                },
                {
                  "label": "No",
                  "value": "no"
                }
              ],
              "required": true
            },
            {
              "id": "teeth",
              "max": 8,
              "min": 0,
              "hint": "If its mouth can't be opened, REJECT IMMEDIATELY.",
              "kind": "number",
              "title": "How many fully and half formed teeth?",
              "required": true
            },
            {
              "id": "teeth_media",
              "kind": "media",
              "slot": "teeth",
              "title": "Photo of teeth",
              "accepts": [
                "photo",
                "video"
              ],
              "required": true,
              "max_files": 5
            },
            {
              "id": "sex",
              "kind": "choice",
              "title": "Gender of the animal?",
              "options": [
                {
                  "label": "Female",
                  "value": "female"
                },
                {
                  "label": "Male",
                  "value": "male"
                }
              ],
              "required": true
            },
            {
              "id": "pregnant",
              "kind": "choice",
              "title": "Is the animal pregnant?",
              "only_if": {
                "value": "female",
                "question_id": "sex"
              },
              "options": [
                {
                  "label": "No",
                  "value": "no"
                },
                {
                  "label": "Yes",
                  "value": "yes"
                }
              ],
              "required": true
            },
            {
              "id": "weight_kg",
              "max": 300,
              "min": 0.5,
              "kind": "number",
              "unit": "kg",
              "title": "Weight of the animal in KG",
              "required": false
            },
            {
              "id": "weight_media",
              "hint": "The scale reading with the animal on it.",
              "kind": "media",
              "slot": "weight",
              "title": "Weight of the animal media",
              "accepts": [
                "photo",
                "video"
              ],
              "required": false,
              "max_files": 1
            },
            {
              "id": "height_cm",
              "max": 200,
              "min": 10,
              "hint": "Measure from the front knee to where the neck meets the body.",
              "kind": "number",
              "unit": "cm",
              "title": "Height of the animal in CM",
              "required": false
            },
            {
              "id": "rectal_temp_c",
              "max": 45,
              "min": 30,
              "kind": "number",
              "unit": "\u00b0C",
              "title": "Rectal temperature of the goat?",
              "required": true
            },
            {
              "id": "temperature_media",
              "kind": "media",
              "slot": "temperature",
              "title": "Rectal temperature media",
              "accepts": [
                "photo",
                "video"
              ],
              "required": false,
              "max_files": 1
            },
            {
              "id": "animal_media",
              "hint": "Walk around the animal so the whole body is seen.",
              "kind": "media",
              "slot": "animal",
              "title": "Goat photo and video with face, udder, body and activity",
              "accepts": [
                "photo",
                "video"
              ],
              "required": true,
              "max_files": 5
            },
            {
              "id": "b",
              "kind": "text",
              "title": "Breed of animal",
              "required": true
            },
            {
              "id": "s",
              "kind": "text",
              "title": "Stage of animal",
              "required": true
            }
          ]
        },
        {
          "key": "face",
          "title": "Face visual productivity check",
          "questions": [
            {
              "id": "anaemic",
              "kind": "choice",
              "title": "Is the animal anaemic?",
              "options": [
                {
                  "label": "Yes",
                  "value": "yes"
                },
                {
                  "label": "No",
                  "value": "no"
                }
              ],
              "required": true
            },
            {
              "id": "mouth_breathing",
              "hint": "Yes for mouth, No for nose.",
              "kind": "choice",
              "title": "Is it breathing through its mouth?",
              "options": [
                {
                  "label": "Yes",
                  "value": "yes"
                },
                {
                  "label": "No",
                  "value": "no"
                }
              ],
              "required": true
            },
            {
              "id": "watery_eyes",
              "hint": "If so, is it clear and watery or yellow and mucus like?",
              "kind": "choice",
              "title": "Does it have watery eyes?",
              "options": [
                {
                  "label": "Yes - clear and watery",
                  "value": "clear"
                },
                {
                  "label": "Yes - yellow and mucus like",
                  "value": "yellow"
                },
                {
                  "label": "No",
                  "value": "no"
                }
              ],
              "required": true
            },
            {
              "id": "eye_colour",
              "kind": "choice",
              "title": "Does it have red or cloudy eyes?",
              "options": [
                {
                  "label": "Yes - red eyes",
                  "value": "red"
                },
                {
                  "label": "Yes - cloudy eyes",
                  "value": "cloudy"
                },
                {
                  "label": "No",
                  "value": "no"
                }
              ],
              "required": true
            },
            {
              "id": "nasal_discharge",
              "hint": "If so, is it clear and runny or yellow and mucus like?",
              "kind": "choice",
              "title": "Does it have a nasal discharge?",
              "options": [
                {
                  "label": "Yes - clear and runny",
                  "value": "clear"
                },
                {
                  "label": "Yes - yellow and mucus like",
                  "value": "yellow"
                },
                {
                  "label": "No",
                  "value": "no"
                }
              ],
              "required": true
            },
            {
              "id": "face_scabs",
              "hint": "Places: eyes, nose, outside mouth, ears, inside mouth around jaws and tongue.",
              "kind": "choice",
              "title": "Any signs of scabby skin or rashes on the face, even one small bump?",
              "options": [
                {
                  "label": "No",
                  "value": "no"
                },
                {
                  "label": "Yes, please mention the area",
                  "value": "other"
                }
              ],
              "required": true,
              "allow_other": true
            }
          ]
        },
        {
          "key": "body",
          "hint": "Checks for what is visible on the body, marked and rejected as per the SOP.",
          "title": "Body visual productivity check",
          "questions": [
            {
              "id": "acidosis",
              "hint": "Is there a fluid sensation on pressing its stomach? It should feel doughy, like kneaded atta.",
              "kind": "choice",
              "title": "Does the animal have acidosis?",
              "options": [
                {
                  "label": "Yes",
                  "value": "yes"
                },
                {
                  "label": "No",
                  "value": "no"
                }
              ],
              "required": true
            },
            {
              "id": "diarrhea",
              "hint": "Check below its tail and look for traces around both back legs.",
              "kind": "choice",
              "title": "Any signs of diarrhea, present or past?",
              "options": [
                {
                  "label": "Yes",
                  "value": "yes"
                },
                {
                  "label": "No",
                  "value": "no"
                }
              ],
              "required": true
            },
            {
              "id": "ticks_hair_loss",
              "hint": "Face | Neck | Visible trunk | Bottom trunk | Front legs (left and right + hoofs) | Rear legs (left and right + hoofs)",
              "kind": "choice",
              "title": "Any presence of ticks or patches of hair loss on the body?",
              "options": [
                {
                  "label": "No",
                  "value": "no"
                },
                {
                  "label": "Yes, please mention where",
                  "value": "other"
                }
              ],
              "required": true,
              "allow_other": true
            },
            {
              "id": "wounds",
              "hint": "Face | Neck | Visible trunk | Bottom trunk | Front legs (left and right + hoofs) | Rear legs (left and right + hoofs)",
              "kind": "choice",
              "title": "Any wounds or physical injuries on the body?",
              "options": [
                {
                  "label": "No",
                  "value": "no"
                },
                {
                  "label": "Yes, please mention where",
                  "value": "other"
                }
              ],
              "required": true,
              "allow_other": true
            },
            {
              "id": "body_scabs",
              "hint": "Places: neck and visible trunk, bottom of trunk, front legs and below hoof (both), rear legs and below hoof (both).",
              "kind": "choice",
              "title": "Any signs of scabby skin or rashes on the body, even one small bump?",
              "options": [
                {
                  "label": "No",
                  "value": "no"
                },
                {
                  "label": "Yes, please mention where",
                  "value": "other"
                }
              ],
              "required": true,
              "allow_other": true
            },
            {
              "id": "lumps",
              "hint": "Tick each of the points 1-14 and mention the numbers where a lump is present.",
              "kind": "choice",
              "title": "Any signs of lumps on the face and body?",
              "options": [
                {
                  "label": "No",
                  "value": "no"
                },
                {
                  "label": "Yes, please mention where",
                  "value": "other"
                }
              ],
              "required": true,
              "allow_other": true
            },
            {
              "id": "arthritis",
              "hint": "Look for swelling in the knees.",
              "kind": "choice",
              "title": "Any signs of arthritis in the knees?",
              "options": [
                {
                  "label": "No",
                  "value": "no"
                },
                {
                  "label": "Yes, please mention where",
                  "value": "other"
                }
              ],
              "required": true,
              "allow_other": true
            },
            {
              "id": "suspicious_media",
              "kind": "media",
              "slot": "suspicious",
              "title": "If anything is suspicious, add a picture of it",
              "accepts": [
                "photo",
                "video"
              ],
              "required": false,
              "max_files": 5
            }
          ]
        },
        {
          "key": "udder",
          "title": "Udder or testicles",
          "questions": [
            {
              "id": "udder_media",
              "kind": "media",
              "slot": "udder",
              "title": "Udder or testicles media",
              "accepts": [
                "photo",
                "video"
              ],
              "required": true,
              "max_files": 1
            },
            {
              "id": "milk_yield",
              "kind": "text",
              "title": "Milk yield",
              "only_if": {
                "value": "female",
                "question_id": "sex"
              },
              "required": false
            },
            {
              "id": "udder_state",
              "kind": "multi",
              "title": "Is the udder or testicle normal or has issues?",
              "options": [
                {
                  "label": "Normal",
                  "value": "normal"
                },
                {
                  "label": "Swollen",
                  "value": "swollen"
                },
                {
                  "label": "Rashes",
                  "value": "rashes"
                },
                {
                  "label": "Lumps",
                  "value": "lumps"
                },
                {
                  "label": "Wounds",
                  "value": "wounds"
                },
                {
                  "label": "Teats not pointing down",
                  "value": "teats_not_down"
                },
                {
                  "label": "Other",
                  "value": "other"
                }
              ],
              "required": true,
              "allow_other": true
            },
            {
              "id": "lactating",
              "kind": "choice",
              "title": "Is it lactating?",
              "only_if": {
                "value": "female",
                "question_id": "sex"
              },
              "options": [
                {
                  "label": "Yes",
                  "value": "yes"
                },
                {
                  "label": "No",
                  "value": "no"
                }
              ],
              "required": true
            },
            {
              "id": "mastitis",
              "kind": "choice",
              "title": "If lactating, results of mastitis test are?",
              "only_if": {
                "value": "yes",
                "question_id": "lactating"
              },
              "options": [
                {
                  "label": "Positive",
                  "value": "positive"
                },
                {
                  "label": "Negative",
                  "value": "negative"
                }
              ],
              "required": false
            },
            {
              "id": "teats",
              "kind": "choice",
              "title": "How many teats are present?",
              "only_if": {
                "value": "female",
                "question_id": "sex"
              },
              "options": [
                {
                  "label": "1",
                  "value": "1"
                },
                {
                  "label": "2",
                  "value": "2"
                },
                {
                  "label": "3",
                  "value": "3"
                },
                {
                  "label": "4",
                  "value": "4"
                }
              ],
              "required": true
            },
            {
              "id": "teat_discharge",
              "kind": "choice",
              "title": "Any pus like discharge from the teats that does not look like milk or colostrum?",
              "only_if": {
                "value": "female",
                "question_id": "sex"
              },
              "options": [
                {
                  "label": "Yes",
                  "value": "yes"
                },
                {
                  "label": "No",
                  "value": "no"
                }
              ],
              "required": true
            },
            {
              "id": "scrotum_cm",
              "max": 60,
              "min": 5,
              "kind": "number",
              "unit": "cm",
              "title": "Male scrotum circumference in CM",
              "only_if": {
                "value": "male",
                "question_id": "sex"
              },
              "required": false
            }
          ]
        },
        {
          "key": "decision",
          "hint": "Your recommendation on the farm. The CEO decides on the web.",
          "title": "Your verdict",
          "questions": [
            {
              "id": "field_verdict",
              "kind": "choice",
              "title": "Decision",
              "options": [
                {
                  "label": "Selected",
                  "value": "selected"
                },
                {
                  "label": "On Hold",
                  "value": "on_hold"
                }
              ],
              "required": true
            },
            {
              "id": "breed",
              "kind": "text",
              "title": "Breed",
              "required": false
            },
            {
              "id": "notes",
              "kind": "text",
              "title": "Note",
              "required": false
            }
          ]
        }
      ],
      "load_form": {
        "questions": [
          {
            "id": "load_ref",
            "hint": "The number the farm gives this load.",
            "kind": "text",
            "title": "Load number",
            "required": true
          },
          {
            "id": "vendor",
            "hint": "From the vendor register.",
            "kind": "vendor",
            "title": "Vendor",
            "required": true
          },
          {
            "id": "farm",
            "kind": "choice",
            "title": "Farm",
            "options": [
              {
                "label": "CBE",
                "value": "CBE"
              },
              {
                "label": "CPT",
                "value": "CPT"
              }
            ],
            "required": true
          },
          {
            "id": "expected_count",
            "max": 10000,
            "min": 0,
            "kind": "number",
            "title": "Roughly how many animals",
            "required": false
          },
          {
            "id": "w",
            "kind": "text",
            "title": "What feed was given to animals at source.",
            "required": true
          },
          {
            "id": "h",
            "kind": "choice",
            "title": "How much quantity was given per day per animal?",
            "options": [
              {
                "label": "Yes",
                "value": "yes"
              },
              {
                "label": "No",
                "value": "no"
              }
            ],
            "required": true
          },
          {
            "id": "notes",
            "kind": "text",
            "title": "Note",
            "required": false
          }
        ]
      },
      "schema_version": "goatos.sop-inspection.v1"
    },
    "schema_version": "goatos.sop-form.v1"
  },
  "proof_policy": {
    "types": [
      "video",
      "photo"
    ],
    "required": true,
    "maximum_count": 20,
    "minimum_count": 3,
    "subject_scope": "task",
    "verify_before_apply": false
  }
}
