  "output_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "verification_item_id",
      "category",
      "verdict",
      "confidence",
      "purpose_checked",
      "summary",
      "observations",
      "claim_comparison",
      "issues",
      "evidence_timestamps",
      "human_review_recommended"
    ],
    "properties": {
      "verification_item_id": {
        "type": "string"
      },
      "category": {
        "enum": [
          "vaccination_proof",
          "weighing_proof",
          "birth_evidence",
          "death_evidence",
          "shifting_move",
          "milk_preparation",
