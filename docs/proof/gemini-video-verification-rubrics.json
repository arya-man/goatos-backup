{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goatos.mesha.sg/schemas/proof/gemini-video-verification-rubrics.schema.json",
  "title": "Goat OS Gemini Proof Media Verification Registry",
  "version": "2026-08-12.2",
  "model_role": "advisory_ai_verifier",
  "authority_boundary": "Gemini output is advisory evidence only. Human Verifier approval or rejection remains authoritative.",
  "coverage_note": "This registry covers active verifier tabs plus known proof/media producers from Goat OS product architecture. New producers must add a category before sending media to Gemini.",
  "prompt_contract": {
    "system_instruction": "You are an advisory proof-media verifier for Goat OS. Verify only the supplied category, media, and app claim. Return JSON only. If evidence is incomplete, dark, shaky, occluded, cropped, ambiguous, still-image insufficient for an action, or missing required app metadata, use needs_human_review with precise reasons. Never invent weight, vaccine, batch, goat identity, shed identity, feed quantity, person identity, or action completion.",
    "user_instruction_template": "Audit this proof media for category {{category}}. Compare visible evidence against supplied metadata and app claim. Return JSON matching output_schema. Focus on whether the operational action is actually proven and why the feature requires this proof.",
    "minimum_input": [
      "verification_item_id",
      "category",
      "media",
      "captured_at",
      "tenant_id",
      "park_id",
      "shed_id",
      "operator_id",
      "app_claim"
    ],
    "common_verifier_item_properties": {
      "verification_item_id": "string",
      "category": "string",
      "vertical": "string",
      "module": "string",
      "status": "pending|approved|rejected|rework|other",
      "row_version": "number|string",
      "captured_at": "timestamp",
      "media": "array<media>",
      "source": "object",
      "subject_label": "string|null",
      "subject_note": "string|null",
      "context_rows": "array|null",
      "operator_id": "string|null",
      "operator_name": "string|null",
      "park_id": "string|null",
      "park_label": "string|null",
      "shed_id": "string|null",
      "shed_label": "string|null",
      "op_location_label": "string|null",
      "verdict": "object|null"
    },
    "common_media_properties": {
      "proof_id": "string",
      "download_url": "signed_url",
      "label": "string|null",
      "answer": "string|null",
      "mime_type": "string|null",
      "duration_ms": "number|null"
    },
    "recommended_model_settings": {
      "temperature": 0,
      "response_mime_type": "application/json"
    }
  },
  "verdict_policy": {
    "allowed_verdicts": [
      "pass",
      "fail",
      "needs_human_review"
    ],
    "pass": "Critical action is visible, category is correct, and app claim is supported within tolerance.",
    "fail": "Visible evidence contradicts the app claim, proves wrong category, or proves required action did not happen properly.",
    "needs_human_review": "Evidence is insufficient, dark, shaky, occluded, cropped, ambiguous, low-confidence, or missing required metadata for comparison.",
    "confidence_thresholds": {
      "strong": 0.85,
      "human_review_below": 0.65
    }
  },
  "shared_checks": [
    {
      "id": "category_match",
      "question": "Does the media match the expected verification category?"
    },
    {
      "id": "media_quality",
      "question": "Is the media clear enough to verify the required action or state?"
    },
    {
      "id": "metadata_sufficiency",
      "question": "Is supplied app metadata sufficient for claim comparison?"
    },
    {
      "id": "authority_boundary",
      "question": "Does the output avoid making operational decisions outside the verifier role?"
    }
  ],
  "categories": {
    "vaccination_proof": {
      "status": "active",
      "aliases": [
        "vaccination"
      ],
      "module": "Vaccination",
      "page": "Vaccination",
      "media": [
        "video",
        "image_optional"
      ],
      "purpose": "Prove the operator administered the claimed vaccine/medical dose to the right animal.",
      "required_app_claim": {
        "goat_id": "string|null",
        "rfid": "string|null",
        "vaccine_name": "string",
        "dose_or_stage": "string",
        "route_site_expected": "string|null",
        "vial_or_batch_required": "boolean"
      },
      "verify": [
        "goat visible",
        "syringe/needle/applicator visible",
        "restraint adequate",
        "administration contact/injection moment visible",
        "clip continuity proves dose not setup only",
        "route/site plausible when supplied",
        "vial/batch visible when required"
      ],
      "fail_reasons": [
        "wrong_category",
        "goat_not_visible",
        "instrument_not_visible",
        "administration_contact_not_visible",
        "setup_only_no_dose",
        "action_hidden",
        "ambiguous_multiple_animals",
        "route_site_contradiction"
      ]
    },
    "weighing_proof": {
      "status": "active",
      "aliases": [
        "weighing"
      ],
      "module": "Weighing",
      "page": "Weighing",
      "media": [
        "video",
        "image_optional"
      ],
      "purpose": "Prove the measured value is real and matches the operator-entered number.",
      "required_app_claim": {
