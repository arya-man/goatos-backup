# ===========================================================================
# .env.ceo-ai.local.example — COMMITTED TEMPLATE (no real values).
#
# Copy to .env.ceo-ai.local (gitignored) for local dev, OR generate it:
#   tools/dev/setup-ceo-ai-local-role.sh   # mint throwaway LOCAL readonly roles
#   tools/dev/fetch-ceo-ai-secrets.sh      # pull staging config from Secret Manager
#
# SECRET SOURCE OF TRUTH: real credential VALUES live in Google Secret Manager
# (project goatos-stg, org vgoats.com) + GitHub Actions secrets (repo
# vgoats/goatos). NEVER commit a real value. See
# docs/runbooks/leadership-assistant-secrets.md for names + retrieval steps.
#
# Legend:  [config] plain, safe to see    [secret] Secret Manager only
# ===========================================================================

# --- AI provider / Vertex (Gemini planner) --------------------------------
MESHA_AI_PROVIDER=vertex                 # [config]
MESHA_VERTEX_PROJECT=goatos-stg          # [config]
MESHA_VERTEX_LOCATION=asia-south1        # [config]
MESHA_VERTEX_MODEL=gemini-2.5-flash      # [config]  Vertex auth = ADC (no key in env)
MESHA_AI_MAX_STEPS=6                     # [config]  bounded agent step loop
MESHA_AI_REVIEW=0                        # [config]  1 enables self-review pass

# --- Cube Core governed metric layer --------------------------------------
MESHA_CUBE_URL=http://127.0.0.1:4000                       # [config] local default
MESHA_CUBE_API_SECRET=REPLACE_ME__from_secret_mesha-cube-api-secret   # [secret]
MESHA_CUBE_DB_USER=mesha_cube_readonly                     # [config]
MESHA_CUBE_DB_PASSWORD=REPLACE_ME__local_generated_or_secret          # [secret]
MESHA_CUBE_DB_DSN=postgres://mesha_cube_readonly:REPLACE_ME@127.0.0.1:5433/goatos?sslmode=disable  # [secret] = secret mesha-cube-readonly-db-url

# --- MCP Toolbox curated ceo_ai.* tools -----------------------------------
MESHA_MCP_TOOLBOX_URL=http://127.0.0.1:5001    # [config] local default
MESHA_MCP_TOOLSET=mesha_ceo_toolset            # [config] = secret mesha-mcp-toolset
MESHA_MCP_DB_USER=mesha_ceo_readonly           # [config]
MESHA_MCP_DB_PASSWORD=REPLACE_ME__local_generated_or_secret   # [secret]
MESHA_MCP_DB_DSN=postgres://mesha_ceo_readonly:REPLACE_ME@127.0.0.1:5433/goatos?sslmode=disable  # [secret] = secret mesha-ceo-readonly-db-url

# --- shared local Postgres coordinates ------------------------------------
MESHA_DATABASE_NAME=goatos              # [config]  local DB on 127.0.0.1:5433
